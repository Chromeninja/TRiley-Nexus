---
// about.astro: About page
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { skillGroups } from "../data/skills";
import { resolveMediaPath } from "../utils/paths";
import { renderRichText } from "../utils/richText";
import { getAboutContentData, type AboutMediaItem } from "../data/aboutContent";

const aboutContent = await getAboutContentData();
const aboutAdditionalMedia = aboutContent.additionalMedia;
const aboutBackgroundParagraphs = aboutContent.backgroundParagraphs;
const aboutProfileMedia: AboutMediaItem | null = aboutContent.profileMedia;
const aboutPersonalItems = aboutContent.personalItems;
const aboutThinkItems = aboutContent.thinkItems;
const aboutValues = aboutContent.values;
const resumeConfig = aboutContent.resume;
const resumePath = resumeConfig
  ? resolveMediaPath(resumeConfig.filePath)
  : undefined;
const skillAtlasCtaLabel =
  aboutContent.skillAtlas?.ctaLabel?.trim() || "Explore Skill Atlas";
const skillAtlasHref = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/about/skill-atlas`;
const leadershipSnapshot = [
  {
    title: "Director-track program leadership",
    body: "Ten-plus years at Ubisoft across seven roles, culminating in Senior Program Manager ownership of Help and customer experience work.",
  },
  {
    title: "Operational discipline under pressure",
    body: "Fifteen-plus years of military service, including Air National Guard air traffic control, shaped how I communicate, plan, and lead when stakes are real.",
  },
  {
    title: "Builder's bias beyond the org chart",
    body: "From automation and community systems to VR Villa tooling, I repeatedly move toward the gap, build what is missing, and leave behind a system others can run.",
  },
];
---

<Layout title="About" description={aboutContent.metaDescription}>
  <!-- Page Hero -->
  <PageHero
    label="// PROFILE"
    title="About Me"
    subtitle="A director-track technical program leader with a builder's bias for systems that hold up in real operating environments."
    meta="15+ years military service • 13+ years in gaming and platform operations • Senior Program Manager at Ubisoft"
  >
    {
      aboutProfileMedia && (
        <figure
          slot="aside"
          class="profile-photo panel"
          aria-label="Profile photo"
        >
          <img
            src={resolveMediaPath(aboutProfileMedia.src)}
            alt={aboutProfileMedia.alt}
            loading="lazy"
          />
        </figure>
      )
    }
    <a slot="actions" class="btn btn-outline" href={skillAtlasHref}>
      <span aria-hidden="true">◈</span>
      {skillAtlasCtaLabel}
    </a>
  </PageHero>

  <section class="section">
    <div class="container container--page">
      <SectionHeader
        label="// LEADERSHIP SNAPSHOT"
        title="How I Operate"
        subtitle="The shortest accurate version is this: I lead ambiguous, cross-functional work by turning it into structure other people can execute."
      />

      <div class="snapshot-grid">
        {
          leadershipSnapshot.map((item) => (
            <div class="snapshot-card">
              <h3 class="snapshot-card__title">{item.title}</h3>
              <p class="snapshot-card__body">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Background -->
  <section class="section section--alt">
    <div class="container container--reading">
      <SectionHeader label="// ORIGIN STORY" title="Background" />

      <div class="prose">
        {
          aboutBackgroundParagraphs.map((paragraph) => (
            <div class="about-rich-text" set:html={renderRichText(paragraph)} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="section">
    <div class="container container--page">
      <SectionHeader
        label="// CAPABILITIES"
        title="Skills & Expertise"
        subtitle="These are the capability clusters that show up most consistently across my career, regardless of title or domain."
      />

      <div class="skills-grid">
        {
          skillGroups.map((group) => (
            <div class="skill-group">
              <div class="skill-group__header">
                <span class="skill-group__icon text-accent" aria-hidden="true">
                  {group.icon}
                </span>
                <h3 class="skill-group__label">{group.label}</h3>
              </div>
              <ul class="skill-list">
                {group.skills.map((skill) => (
                  <li class="skill-item">
                    <span class="skill-item__dot" aria-hidden="true">
                      ▸
                    </span>
                    {skill}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How I Think -->
  <section class="section section--alt">
    <div class="container container--page">
      <SectionHeader
        label="// MENTAL MODELS"
        title="How I Think"
        subtitle="The operating assumptions below are the reason my work tends to look the way it does."
      />

      <div class="think-grid">
        {
          aboutThinkItems.map((item) => (
            <div class="think-card">
              <h3 class="think-card__title">{item.title}</h3>
              <div
                class="think-card__text about-rich-text about-rich-text--compact"
                set:html={renderRichText(item.text)}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Personal -->
  <section class="section section--alt">
    <div class="container container--page">
      <SectionHeader
        label="// LIFE OUTSIDE WORK"
        title="Context Outside Work"
        subtitle="These are the parts of my life that explain what I value, how I recharge, and why I keep building outside formal roles."
      />

      <div class="personal-grid">
        {
          aboutPersonalItems.map((item) => (
            <div class="personal-card">
              <span class="personal-card__icon">{item.icon}</span>
              <h3>{item.title}</h3>
              <div
                class="personal-card__body about-rich-text about-rich-text--compact"
                set:html={renderRichText(item.body)}
              />
            </div>
          ))
        }
      </div>

      {
        aboutAdditionalMedia.length > 0 && (
          <div class="photo-strip" aria-label="Additional photos">
            {aboutAdditionalMedia.map((item) => (
              <figure class="photo-slot">
                <img
                  src={resolveMediaPath(item.src)}
                  alt={item.alt}
                  loading="lazy"
                />
                {item.caption && (
                  <figcaption class="text-mono text-muted">
                    {item.caption}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- What Matters -->
  <section class="section">
    <div class="container container--reading">
      <SectionHeader
        label="// CORE VALUES"
        title="What Matters to Me"
        centered
      />

      <div class="values-list">
        {
          aboutValues.map((value) => (
            <div class="value-item">
              <span class="value-item__check text-accent" aria-hidden="true">
                ✓
              </span>
              <span>{value}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    resumeConfig && resumePath && (
      <section class="section section--alt">
        <div class="container container--reading">
          <SectionHeader label="// RESUME" title={resumeConfig.title} />

          <div class="resume-panel panel">
            {resumeConfig.summary && (
              <p class="resume-panel__summary">{resumeConfig.summary}</p>
            )}

            <p class="resume-panel__updated text-mono text-muted">
              Last updated: <span>{resumeConfig.lastUpdated}</span>
            </p>

            <div class="resume-panel__actions">
              <a
                href={resumePath}
                class="btn btn-primary"
                target="_blank"
                rel="noopener noreferrer"
              >
                View Resume
              </a>
              <a href={resumePath} class="btn btn-outline" download>
                Download Resume
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }
</Layout>

<style>
  .snapshot-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .snapshot-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
  }

  .snapshot-card__title {
    font-size: var(--font-size-card-title);
    color: var(--color-text-heading);
    margin-bottom: var(--space-sm);
  }

  .snapshot-card__body {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-body);
    line-height: 1.7;
  }

  .profile-photo {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-md);
  }

  .profile-photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-card);
  }

  .resume-panel {
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .resume-panel__summary {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-body);
    line-height: 1.65;
  }

  .resume-panel__updated {
    margin: 0;
    font-size: var(--font-size-meta);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .resume-panel__updated span {
    color: var(--color-text);
  }

  .resume-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* Think cards */
  .think-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-lg);
  }

  .think-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
  }

  .think-card__title {
    font-size: var(--font-size-card-title);
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
  }

  .think-card__text {
    font-size: var(--font-size-body-sm);
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
  }

  .personal-card__body {
    margin: 0;
  }

  .about-rich-text {
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .about-rich-text > :first-child {
    margin-top: 0;
  }

  .about-rich-text > :last-child {
    margin-bottom: 0;
  }

  .about-rich-text :global(p) {
    margin: 0 0 var(--space-sm);
  }

  .about-rich-text :global(ul),
  .about-rich-text :global(ol) {
    margin: 0 0 var(--space-sm);
    padding-left: 1.25rem;
  }

  .about-rich-text :global(li) {
    margin-bottom: 0.45rem;
  }

  .about-rich-text :global(li + li) {
    margin-top: 0.3rem;
  }

  .about-rich-text :global(li > p) {
    margin: var(--space-xs) 0 0;
  }

  .about-rich-text :global(strong) {
    color: var(--color-text);
    font-weight: 700;
  }

  .about-rich-text :global(em) {
    color: var(--color-text);
    font-style: italic;
  }

  .about-rich-text--compact :global(p),
  .about-rich-text--compact :global(ul),
  .about-rich-text--compact :global(ol) {
    margin-bottom: var(--space-xs);
  }

  /* Skills */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-xl);
  }

  .skill-group {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
  }

  .skill-group__header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .skill-group__icon {
    font-size: 1.1rem;
    line-height: 1;
  }

  .skill-group__label {
    font-size: var(--font-size-card-title);
    font-weight: 500;
    color: var(--color-text-heading);
    line-height: 1.3;
  }

  .skill-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .skill-item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--font-size-body-sm);
    color: var(--color-text-muted);
  }

  .skill-item__dot {
    color: var(--color-accent);
    font-size: 0.7rem;
    flex-shrink: 0;
  }

  /* Personal */
  .personal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-xl);
  }

  .personal-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    transition: border-color var(--transition-base);
  }

  .personal-card:hover {
    border-color: var(--color-border-strong);
  }

  .personal-card__icon {
    display: block;
    font-size: 1.5rem;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
    line-height: 1;
  }

  .personal-card h3 {
    font-size: var(--font-size-card-title);
    margin-bottom: var(--space-sm);
  }

  .personal-card p {
    font-size: var(--font-size-body-sm);
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
  }

  .photo-strip {
    margin-top: var(--space-xl);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .photo-slot {
    margin: 0;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .photo-slot img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
  }

  .photo-slot figcaption {
    font-size: var(--font-size-meta);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0;
  }

  /* Values */
  .values-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .value-item {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--font-size-body);
    color: var(--color-text-muted);
    transition: border-color var(--transition-fast);
  }

  .value-item:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .value-item__check {
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .profile-photo {
      max-width: 320px;
    }

    .snapshot-grid,
    .think-grid,
    .skills-grid,
    .personal-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .think-card,
    .skill-group,
    .personal-card {
      padding: var(--space-lg);
    }

    .value-item {
      align-items: start;
      padding: var(--space-md);
    }

    .photo-strip {
      grid-template-columns: 1fr;
      margin-top: var(--space-lg);
    }
  }
</style>
