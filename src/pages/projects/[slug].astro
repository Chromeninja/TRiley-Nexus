---
// projects/[slug].astro: Individual project detail page
import Layout from "../../layouts/Layout.astro";
import ProjectMediaGallery from "../../components/ProjectMediaGallery.astro";
import {
  formatProjectDateRange,
  getProjects,
  projectStatusColors,
  projectStatusLabels,
  type Project,
} from "../../data/projects";
import { toBasePath } from "../../utils/paths";
import { renderRichText } from "../../utils/richText";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props as Props;
const projectDateRange = formatProjectDateRange(project);

const normalizedProjectMedia = (() => {
  const media = Array.isArray(project.media) ? [...project.media] : [];
  const legacyCoverSrc = String(project.cover?.src ?? "").trim();
  if (!legacyCoverSrc) {
    return media;
  }

  const existingCoverIndex = media.findIndex(
    (item) => item.type === "image" && item.src === legacyCoverSrc,
  );
  if (existingCoverIndex >= 0) {
    media[existingCoverIndex] = {
      ...media[existingCoverIndex],
      isCover: true,
    };
    return media;
  }

  return [
    {
      type: "image" as const,
      src: legacyCoverSrc,
      alt: project.cover?.alt ?? `${project.title} cover image`,
      isCover: true,
    },
    ...media,
  ];
})();
---

<Layout title={project.title} description={project.summary}>
  <!-- Breadcrumb -->
  <div class="breadcrumb-bar">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          <li><a href={toBasePath("/")}>Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={toBasePath("/projects")}>Projects</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{project.title}</li>
        </ol>
      </nav>
    </div>
  </div>

  <article class="section">
    <div class="container">
      <div class="project-layout">
        <!-- Main content -->
        <main class="project-main">
          <!-- Header -->
          <header class="project-header">
            <div class="project-header__meta">
              <span class={`badge ${projectStatusColors[project.status]}`}
                >{projectStatusLabels[project.status]}</span
              >
              <span class="badge badge-purple">{project.category}</span>
            </div>
            <h1 class="project-header__title">{project.title}</h1>
            {
              projectDateRange && (
                <p class="project-header__timeframe text-mono text-muted">
                  {projectDateRange}
                </p>
              )
            }
            {
              project.organization &&
                (project.organizationUrl ? (
                  <p class="project-header__org text-muted">
                    <a
                      href={project.organizationUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {project.organization}
                    </a>
                  </p>
                ) : (
                  <p class="project-header__org text-muted">
                    {project.organization}
                  </p>
                ))
            }
            {
              project.roleTitle && (
                <p class="project-header__role text-mono text-muted">
                  {project.roleTitle}
                </p>
              )
            }
            <p class="project-header__summary">{project.summary}</p>
          </header>

          {
            project.highlights && project.highlights.length > 0 && (
              <section
                class="project-proof"
                aria-labelledby="project-proof-heading"
              >
                <p class="project-proof__kicker text-mono">Proof points</p>
                <h2 id="project-proof-heading">What the work changed</h2>
                <ul>
                  {project.highlights.map((highlight: string) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            normalizedProjectMedia.length > 0 && (
              <ProjectMediaGallery media={normalizedProjectMedia} />
            )
          }

          <!-- Problem -->
          {
            project.problem && (
              <section class="detail-section">
                <header class="detail-section__header">
                  <p class="detail-section__kicker text-mono">01 // Context</p>
                  <h2 class="detail-section__title">The problem</h2>
                </header>
                <div
                  class="rich-text"
                  set:html={renderRichText(project.problem)}
                />
              </section>
            )
          }

          <!-- Approach -->
          {
            project.approach && (
              <section class="detail-section">
                <header class="detail-section__header">
                  <p class="detail-section__kicker text-mono">
                    02 // Ownership
                  </p>
                  <h2 class="detail-section__title">Approach</h2>
                </header>
                <div
                  class="rich-text"
                  set:html={renderRichText(project.approach)}
                />
              </section>
            )
          }

          <!-- Outcome -->
          {
            project.outcome && (
              <section class="detail-section">
                <header class="detail-section__header">
                  <p class="detail-section__kicker text-mono">03 // Result</p>
                  <h2 class="detail-section__title">Outcome</h2>
                </header>
                <div
                  class="rich-text"
                  set:html={renderRichText(project.outcome)}
                />
              </section>
            )
          }

          <!-- Links -->
          {
            project.links && project.links.length > 0 && (
              <section class="detail-section">
                <h2 class="detail-section__title">Links</h2>
                <div class="project-links">
                  {project.links.map((link: { label: string; url: string }) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-outline btn-sm"
                    >
                      {link.label} ↗
                    </a>
                  ))}
                </div>
              </section>
            )
          }
        </main>

        <!-- Sidebar -->
        <aside class="project-sidebar">
          <div class="sidebar-card sidebar-card--summary">
            <h2 class="sidebar-card__title">At a glance</h2>
            <dl class="sidebar-facts">
              <div>
                <dt>Status</dt>
                <dd>{projectStatusLabels[project.status]}</dd>
              </div>
              <div>
                <dt>Focus area</dt>
                <dd>{project.category}</dd>
              </div>
              {
                projectDateRange && (
                  <div>
                    <dt>Timeframe</dt>
                    <dd>{projectDateRange}</dd>
                  </div>
                )
              }
              {
                project.organization && (
                  <div>
                    <dt>Organization</dt>
                    <dd>{project.organization}</dd>
                  </div>
                )
              }
            </dl>
          </div>

          <!-- Skills -->
          {
            project.skills && project.skills.length > 0 && (
              <div class="sidebar-card">
                <h3 class="sidebar-card__title">Skills</h3>
                <ul class="sidebar-list">
                  {project.skills.map((skill: string) => (
                    <li class="sidebar-list__item">
                      <span
                        class="sidebar-list__dot text-accent"
                        aria-hidden="true"
                      >
                        ◆
                      </span>
                      {skill}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <!-- Tools -->
          {
            project.tools && project.tools.length > 0 && (
              <div class="sidebar-card">
                <h3 class="sidebar-card__title">Tools & Stack</h3>
                <div class="tag-cloud">
                  {project.tools.map((tool: string) => (
                    <span class="badge badge-cyan">{tool}</span>
                  ))}
                </div>
              </div>
            )
          }

          <!-- Tags -->
          {
            project.tags && project.tags.length > 0 && (
              <div class="sidebar-card">
                <h3 class="sidebar-card__title">Tags</h3>
                <div class="tag-cloud">
                  {project.tags.map((tag: string) => (
                    <span class="badge badge-purple">{tag}</span>
                  ))}
                </div>
              </div>
            )
          }

          <!-- Back link -->
          <div>
            <a
              href={toBasePath("/projects")}
              class="btn btn-ghost project-sidebar__back-link"
            >
              ← All Projects
            </a>
          </div>
        </aside>
      </div>
    </div>
  </article>
</Layout>

<style>
  /* Breadcrumb */
  .breadcrumb-bar {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    padding-block: var(--space-sm);
  }

  .breadcrumb {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }
  .breadcrumb [aria-current="page"] {
    color: var(--color-text);
  }

  /* Layout */
  .project-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--space-3xl);
    align-items: start;
  }

  /* Header */
  .project-header {
    margin-bottom: var(--space-3xl);
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
  }

  .project-header__meta {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-lg);
  }

  .project-header__title {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    margin-bottom: var(--space-sm);
    line-height: 1.15;
  }

  .project-header__timeframe {
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-xs);
  }

  .project-header__org {
    font-size: 0.9rem;
    margin-bottom: var(--space-xs);
  }

  .project-header__role {
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-lg);
  }

  .project-header__org a {
    color: inherit;
    text-decoration: none;
  }

  .project-header__org a:hover,
  .project-header__org a:focus-visible {
    color: var(--color-accent);
  }

  .project-header__summary {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 70ch;
    margin: 0;
  }

  .project-proof {
    margin-bottom: var(--space-3xl);
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-secondary);
  }

  .project-proof__kicker {
    margin: 0 0 var(--space-sm);
    color: var(--color-accent);
    font-size: var(--font-size-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-proof h2 {
    margin: 0 0 var(--space-lg);
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
  }

  .project-proof ul {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding-left: var(--space-lg);
    color: var(--color-text);
    line-height: 1.65;
  }

  /* Detail sections */
  .detail-section {
    margin-bottom: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .detail-section:last-of-type {
    margin-bottom: 0;
  }

  .detail-section__header {
    margin-bottom: var(--space-lg);
  }

  .detail-section__kicker {
    margin: 0 0 var(--space-xs);
    color: var(--color-accent);
    font-size: var(--font-size-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .detail-section__title {
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    margin: 0;
  }

  .detail-section p {
    color: var(--color-text-muted);
    line-height: 1.75;
    max-width: 70ch;
  }

  .rich-text {
    color: var(--color-text-muted);
    line-height: 1.75;
    max-width: 70ch;
  }

  .rich-text > :first-child {
    margin-top: 0;
  }

  .rich-text > :last-child {
    margin-bottom: 0;
  }

  .rich-text :global(p) {
    margin: 0 0 var(--space-sm);
  }

  .rich-text :global(ul),
  .rich-text :global(ol) {
    margin: 0 0 var(--space-sm);
    padding-left: 1.25rem;
  }

  .rich-text :global(li > ul),
  .rich-text :global(li > ol) {
    margin: var(--space-xs) 0 0;
    margin-left: 1rem;
    padding-left: 1rem;
  }

  .rich-text :global(li > p) {
    margin: var(--space-xs) 0 0;
    max-width: none;
  }

  .rich-text :global(li) {
    margin-bottom: 0.55rem;
  }

  .rich-text :global(li + li) {
    margin-top: 0.45rem;
  }

  .rich-text :global(strong) {
    color: var(--color-text);
    font-weight: 700;
  }

  .rich-text :global(em) {
    color: var(--color-text);
    font-style: italic;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* Sidebar */
  .project-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    position: sticky;
    top: calc(var(--nav-height) + var(--space-xl));
  }

  .project-sidebar__back-link {
    width: 100%;
    justify-content: center;
  }

  .sidebar-card {
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .sidebar-card--summary {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
  }

  .sidebar-card__title {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }

  .sidebar-facts {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
  }

  .sidebar-facts div {
    display: grid;
    gap: var(--space-xs);
  }

  .sidebar-facts dt {
    color: var(--color-text-dim);
    font-family: var(--font-mono);
    font-size: var(--font-size-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sidebar-facts dd {
    margin: 0;
    color: var(--color-text);
    font-size: var(--font-size-body-sm);
    line-height: 1.45;
  }

  .sidebar-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .sidebar-list__item {
    display: flex;
    align-items: start;
    gap: var(--space-sm);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .sidebar-list__dot {
    font-size: 0.4rem;
    margin-top: 5px;
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .project-layout {
      grid-template-columns: 1fr;
    }

    .project-sidebar {
      position: static;
      order: 0;
    }
  }

  @media (max-width: 640px) {
    .breadcrumb {
      font-size: 0.72rem;
      gap: 0.3rem;
    }

    .project-header {
      margin-bottom: var(--space-2xl);
      padding-bottom: var(--space-xl);
    }

    .project-header__summary {
      font-size: 0.98rem;
      line-height: 1.65;
    }

    .detail-section__title {
      font-size: 1.2rem;
    }

    .detail-section p {
      font-size: 0.95rem;
      line-height: 1.7;
    }

    .rich-text {
      font-size: 0.95rem;
      line-height: 1.7;
    }
  }
</style>
