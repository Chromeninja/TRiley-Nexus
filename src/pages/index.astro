---
// index.astro: Homepage
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { homePrinciples, homeStats } from "../data/homeContent";
import { coreStrengths } from "../data/skills";
import { toBasePath } from "../utils/paths";
import { siteConfig } from "../data/siteConfig";

const homeHero = siteConfig.home.hero;
const hiringProfiles = siteConfig.home.hiringProfiles;
const featuredHighlights = siteConfig.home.featuredHighlights;
const featuredStrengths = coreStrengths.filter((strength) =>
  [
    "Operational Clarity",
    "Program Execution",
    "Automation and Tooling",
    "Leadership Under Pressure",
  ].includes(strength.title),
);
const helpAreaLabels = [
  "Program momentum",
  "Day-to-day systems",
  "Useful tooling",
];
const strengthModes = ["Clarify", "Coordinate", "Systemize", "Hold"];
---

<Layout
  title={siteConfig.site.baseTitle}
  description={siteConfig.home.metaDescription}
>
  <!-- ═══════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════ -->
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div class="hero__content animate-fade-up">
          <p class="hero__eyebrow section-label">{homeHero.eyebrow}</p>
          <p class="hero__role-line text-mono">{homeHero.roleLine}</p>
          <h1 class="hero__headline">
            {homeHero.headlineLead}
            <span class="hero__headline-accent">
              {homeHero.headlineAccent}</span
            >
            {homeHero.headlineTail}
          </h1>
          <p class="hero__subtext">
            {homeHero.subtext}
          </p>
          <p class="hero__supporting-text">
            {homeHero.supportingText}
          </p>
          <ul class="hero__quick-notes" aria-label="A few things I have done">
            {
              homeHero.quickNotes.map((point) => (
                <li class="hero__quick-note">{point}</li>
              ))
            }
          </ul>
          <div class="hero__actions">
            <a
              href={toBasePath(homeHero.primaryAction.href)}
              class="btn btn-primary">{homeHero.primaryAction.label}</a
            >
            <a
              href={toBasePath(homeHero.secondaryAction.href)}
              class="btn btn-outline">{homeHero.secondaryAction.label}</a
            >
          </div>
        </div>

        <div
          class="hero__highlights animate-fade-up delay-200"
          aria-label="A few career highlights"
        >
          <div class="hero__highlights-head">
            <p class="hero__highlights-label text-mono">
              A FEW THINGS I'VE BUILT
            </p>
          </div>

          <div class="hero__highlights-intro">
            <h2 class="hero__highlights-title">
              A wide mix of work, tied together by follow-through.
            </h2>
            <p class="hero__highlights-copy">
              Across military service, games, community work, and live events,
              I tend to do the same useful thing: find the messy middle, make it
              easier to understand, and help people move.
            </p>
          </div>

          <div class="hero__highlights-grid">
            {
              featuredHighlights.map((item) => (
                <a
                  class="hero__highlights-card"
                  href={toBasePath(item.href)}
                  aria-label={`${item.label}: ${item.detail}`}
                >
                  <span class="hero__highlights-value">{item.value}</span>
                  <span class="hero__highlights-card-label">{item.label}</span>
                  <p class="hero__highlights-card-detail">{item.detail}</p>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       WHAT I SOLVE
  ═══════════════════════════════════════════ -->
  <section class="section help-section">
    <div class="container">
      <SectionHeader
        label="// WHAT I SOLVE"
        title="Where I Tend To Help"
        subtitle="I am at my best when the work is important, a little tangled, and in need of someone who can make the path feel doable."
      />

      <div class="profile-list">
        {
          hiringProfiles.map((profile, i) => (
            <article
              class={`profile-card animate-fade-up delay-${Math.min((i + 1) * 100, 400)}`}
            >
              <p class="profile-card__kicker text-mono">
                {helpAreaLabels[i] ?? `Focus ${i + 1}`}
              </p>
              <div class="profile-card__body">
                <h3 class="profile-card__title">{profile.title}</h3>
                <p class="profile-card__desc">{profile.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
      HOW I WORK
  ═══════════════════════════════════════════ -->
  <section class="section section--band">
    <div class="container">
      <SectionHeader
        label="// HOW I WORK"
        title="How I Usually Approach the Work"
        subtitle="A short version of how I move from fuzzy problem to shared plan, useful system, and cleaner handoff."
      />

      <ol class="principles-list">
        {
          homePrinciples.map((principle) => (
            <li class="principle">
              <span class="principle__num text-mono" aria-hidden="true">
                {principle.num}
              </span>
              <p class="principle__text">{principle.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="section-actions">
        <a href={toBasePath("/how-i-work")} class="btn btn-outline"
          >See how I work</a
        >
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CORE STRENGTHS
  ═══════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <SectionHeader
        label="// CAPABILITIES"
        title="What I Bring To The Work"
        subtitle="I connect systems thinking, calm execution, useful tooling, and steady leadership across whatever domain the work lives in."
      />

      <div class="strengths-list">
        {
          featuredStrengths.map((strength, i) => (
            <article
              class={`strength-row animate-fade-up delay-${Math.min((i + 1) * 100, 400)}`}
            >
              <span class="strength-row__mode text-mono">
                {strengthModes[i] ?? "Build"}
              </span>
              <span class="strength-row__icon" aria-hidden="true">
                {strength.icon}
              </span>
              <div class="strength-row__body">
                <h3 class="strength-row__title">{strength.title}</h3>
                <p class="strength-row__desc">{strength.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CAREER TIMELINE HUB
  ═══════════════════════════════════════════ -->
  <section class="section section--band career-section">
    <div class="container">
      <SectionHeader
        label="// CAREER ARC"
        title="See How The Work Connects"
        subtitle="The career page pulls the whole path together, from frontline support and military operations to program leadership, community systems, and live-event work."
      />

      <div class="career-hub-card">
        <p class="career-hub-card__label text-mono">
          Three ways to browse the same body of work
        </p>
        <p class="career-hub-card__copy text-muted">
          Use narrative view for the story, gantt for role and project overlap,
          or scroll for the full progression in one pass.
        </p>
        <div class="career-hub-card__actions">
          <a href={toBasePath("/career?view=narrative")} class="btn btn-primary"
            >Open Narrative View</a
          >
          <a href={toBasePath("/career?view=gantt")} class="btn btn-outline"
            >Open Gantt View</a
          >
          <a href={toBasePath("/career?view=scroll")} class="btn btn-ghost"
            >Open Scroll View</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PERSONAL INTRO
  ═══════════════════════════════════════════ -->
  <section class="section section--band intro-section">
    <div class="container">
      <div class="intro-grid">
        <div class="intro__text">
          <p class="section-label">// BACKGROUND</p>
          <span class="accent-line"></span>
          <h2>Why this background fits messy work</h2>
          <p>
            My background is broad on purpose. Military service taught me how to
            lead under pressure, Ubisoft taught me how large organizations
            actually move work, and community and event systems gave me places
            to keep building beyond formal job boundaries.
          </p>
          <p>
            That mix is why I tend to operate well above a narrow title line. I
            am comfortable in the strategy layer, the execution layer, and the
            system-design layer at the same time.
          </p>
          <p>
            If you want the fuller version, the About page explains where that
            operating style came from and why I keep getting pulled toward
            systems that need to be clarified, rebuilt, or scaled.
          </p>
          <a href={toBasePath("/about")} class="btn btn-outline intro__action"
            >Read the background</a
          >
        </div>

        <div class="intro__stats">
          {
            homeStats.map((stat) => (
              <div class="stat-card">
                <span class="stat-card__value">{stat.value}</span>
                <span class="stat-card__label">{stat.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CTA
  ═══════════════════════════════════════════ -->
  <section class="section section--sm">
    <div class="container">
      <div class="cta-panel">
        <p class="section-label">// WORK TOGETHER</p>
        <h2>Let's build something together.</h2>
        <p>
          I'm open to roles in technical program management, operations
          leadership, and innovation-focused systems work. If you're building
          something complex and need someone who can align people, process, and
          execution, reach out.
        </p>
        <div class="cta-panel__actions">
          <a href={toBasePath("/contact")} class="btn btn-primary"
            >Get in Touch</a
          >
          <a href={toBasePath("/now")} class="btn btn-ghost"
            >What I'm Working On</a
          >
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .section--band {
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-bg-secondary), transparent 8%),
        color-mix(in srgb, var(--color-bg), transparent 16%)
      ),
      var(--color-bg-secondary);
    border-block: 1px solid var(--color-border);
  }

  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-4xl);
    min-height: calc(100vh - var(--nav-height));
    display: flex;
    align-items: center;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.95fr);
    gap: var(--space-3xl);
    align-items: center;
  }

  .hero__eyebrow {
    margin-bottom: var(--space-md);
  }

  .hero__role-line {
    margin: 0 0 var(--space-md);
    color: var(--color-accent);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__headline {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.15;
    margin-bottom: var(--space-lg);
  }

  .hero__headline-accent {
    color: var(--color-accent);
    position: relative;
  }

  .hero__subtext {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 52ch;
    margin-bottom: var(--space-md);
  }

  .hero__supporting-text {
    color: var(--color-text);
    max-width: 56ch;
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .hero__quick-notes {
    display: grid;
    gap: var(--space-xs);
    margin: 0 0 var(--space-xl);
    padding-left: 1.15rem;
    color: var(--color-text-muted);
  }

  .hero__quick-note {
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .hero__highlights {
    min-height: 0;
    padding: var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    position: relative;
    border-block: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-bg-card), transparent 8%),
        color-mix(in srgb, var(--color-bg-secondary), transparent 18%)
      ),
      var(--color-bg-card);
    box-shadow: var(--shadow-card);
  }

  .hero__highlights-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    position: relative;
    z-index: 1;
  }

  .hero__highlights-label {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
  }

  .hero__highlights-intro {
    position: relative;
    z-index: 1;
  }

  .hero__highlights-title {
    margin: 0 0 var(--space-sm);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    color: var(--color-text-heading);
  }

  .hero__highlights-copy {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .hero__highlights-grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-sm);
  }

  .hero__highlights-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(5.5rem, auto) minmax(0, 1fr);
    grid-template-areas:
      "value label"
      "value detail";
    column-gap: var(--space-lg);
    row-gap: var(--space-xs);
    padding: var(--space-md);
    border-top: 1px solid var(--color-border);
    background: transparent;
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      background var(--transition-fast),
      transform var(--transition-fast);
  }

  .hero__highlights-card:first-child {
    border-top: 0;
  }

  .hero__highlights-card:hover {
    background: color-mix(in srgb, var(--color-accent), transparent 94%);
    border-color: var(--color-border-strong);
    transform: translateY(-2px);
  }

  .hero__highlights-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: var(--space-xs);
  }

  .hero__highlights-value {
    grid-area: value;
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3vw, 2.65rem);
    line-height: 1;
    color: var(--color-text-heading);
  }

  .hero__highlights-card-label {
    grid-area: label;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero__highlights-card-detail {
    grid-area: detail;
    margin: 0;
    font-size: 0.86rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .profile-list {
    display: grid;
    gap: var(--space-sm);
  }

  .profile-card {
    display: grid;
    grid-template-columns: minmax(8rem, 0.28fr) minmax(0, 1fr);
    gap: var(--space-xl);
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .profile-card:first-child {
    border-top-color: var(--color-border-strong);
  }

  .profile-card__kicker {
    margin: 0;
    font-size: 0.72rem;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .profile-card__title {
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    color: var(--color-text-heading);
    margin-bottom: var(--space-sm);
  }

  .profile-card__desc {
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.7;
  }

  .section-actions {
    margin-top: var(--space-2xl);
  }

  .principles-list {
    list-style: none;
    display: grid;
    gap: var(--space-md);
    max-width: var(--container-md);
  }

  .principle {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: start;
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .principle__num {
    color: var(--color-accent);
    font-size: 0.9rem;
    letter-spacing: 0.12em;
  }

  .principle__text {
    color: var(--color-text);
    line-height: 1.7;
    margin: 0;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
  }

  .strengths-list {
    display: grid;
    gap: var(--space-sm);
  }

  .strength-row {
    display: grid;
    grid-template-columns: minmax(5.5rem, auto) auto minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: start;
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .strength-row:first-child {
    border-top-color: var(--color-border-strong);
  }

  .strength-row__mode {
    color: var(--color-accent);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .strength-row__icon {
    color: var(--color-text-dim);
    font-size: 1rem;
    line-height: 1.4;
  }

  .strength-row__title {
    margin-bottom: var(--space-sm);
    color: var(--color-text-heading);
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
  }

  .strength-row__desc {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(260px, 0.9fr);
    gap: var(--space-2xl);
    align-items: start;
  }

  .intro__text h2 {
    margin-bottom: var(--space-lg);
  }

  .intro__text p {
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .intro__action {
    margin-top: var(--space-md);
  }

  .intro__stats {
    display: grid;
    gap: var(--space-sm);
  }

  .stat-card {
    border-left: 1px solid var(--color-border-strong);
    padding: var(--space-sm) 0 var(--space-sm) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .stat-card__value {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
  }

  .stat-card__label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .career-hub-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-xl);
    align-items: center;
    padding-block: var(--space-xl);
    border-block: 1px solid var(--color-border);
  }

  .career-hub-card__label {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-accent);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .career-hub-card__copy {
    margin: 0;
    max-width: 62ch;
    line-height: 1.7;
  }

  .career-hub-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .cta-panel {
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-accent), transparent 94%),
        transparent
      ),
      var(--color-bg-card);
    border: 1px solid color-mix(in srgb, var(--color-accent2), transparent 72%);
    border-radius: var(--radius-lg);
    padding: var(--space-3xl);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .cta-panel h2 {
    margin-block: var(--space-md);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .cta-panel p {
    color: var(--color-text-muted);
    max-width: 55ch;
    margin-inline: auto;
    line-height: 1.7;
  }

  .cta-panel__actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-xl);
  }

  @media (max-width: 1024px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .hero {
      min-height: auto;
      padding-block: var(--space-3xl);
    }

    .intro-grid {
      grid-template-columns: 1fr;
    }

    .career-hub-card {
      grid-template-columns: 1fr;
    }

    .career-hub-card__actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: var(--space-3xl);
    }

    .hero__highlights {
      padding: var(--space-lg);
    }

    .hero__highlights-card {
      grid-template-columns: 1fr;
      grid-template-areas:
        "value"
        "label"
        "detail";
      gap: var(--space-xs);
    }

    .profile-card,
    .principle,
    .strength-row {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .intro__stats {
      grid-template-columns: 1fr;
    }

    .career-hub-card__actions,
    .cta-panel__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .cta-panel {
      padding: var(--space-2xl) var(--space-lg);
    }
  }
</style>
