---
// index.astro: Homepage
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import {
  homeFeaturedStrengths,
  homePrinciples,
  homeProjectFocusAreas,
  homeStats,
} from "../data/homeContent";
import { toBasePath } from "../utils/paths";
import { siteConfig } from "../data/siteConfig";

const homeHero = siteConfig.home.hero;
const hiringProfiles = siteConfig.home.hiringProfiles;
const featuredEvidence = siteConfig.home.featuredEvidence;
const featuredStrengths = homeFeaturedStrengths;
const projectFocusAreas = homeProjectFocusAreas;
---

<Layout
  title={siteConfig.site.baseTitle}
  description={siteConfig.home.metaDescription}
>
  <!-- ═══════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════ -->
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div class="hero__content animate-fade-up">
          <p class="hero__eyebrow section-label">{homeHero.eyebrow}</p>
          <p class="hero__role-line text-mono">{homeHero.roleLine}</p>
          <h1 class="hero__headline">
            {homeHero.headlineLead}
            <span class="hero__headline-accent">
              {homeHero.headlineAccent}</span
            >
            {homeHero.headlineTail}
          </h1>
          <p class="hero__subtext">
            {homeHero.subtext}
          </p>
          <p class="hero__supporting-text">
            {homeHero.supportingText}
          </p>
          <ul class="hero__proof-list" aria-label="Selected proof points">
            {
              homeHero.proofPoints.map((point) => (
                <li class="hero__proof-pill">{point}</li>
              ))
            }
          </ul>
          <div class="hero__actions">
            <a
              href={toBasePath(homeHero.primaryAction.href)}
              class="btn btn-primary">{homeHero.primaryAction.label}</a
            >
            <a
              href={toBasePath(homeHero.secondaryAction.href)}
              class="btn btn-outline">{homeHero.secondaryAction.label}</a
            >
          </div>
        </div>

        <div
          class="hero__evidence panel animate-fade-up delay-200"
          aria-label="Selected proof of impact"
        >
          <div class="hero__evidence-head">
            <p class="hero__evidence-label text-mono">PROOF LEDGER</p>
            <span class="hero__evidence-status">Evidence</span>
          </div>

          <div class="hero__evidence-intro">
            <h2 class="hero__evidence-title">Evidence before adjectives.</h2>
            <p class="hero__evidence-copy">
              The portfolio is broad, but the proof follows one pattern: clarify
              ownership, design the operating system, and leave people with a
              cleaner way to execute.
            </p>
          </div>

          <div class="hero__evidence-grid">
            {
              featuredEvidence.map((item) => (
                <a class="hero__evidence-card" href={toBasePath(item.href)}>
                  <span class="hero__evidence-value">{item.value}</span>
                  <span class="hero__evidence-card-label">{item.label}</span>
                  <p class="hero__evidence-card-detail">{item.detail}</p>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       WHAT I SOLVE
  ═══════════════════════════════════════════ -->
  <section class="section">
    <div class="container container--page">
      <SectionHeader
        label="// WHAT I SOLVE"
        title="Where I Create Leverage"
        subtitle="I am most useful when an organization needs one operator who can clarify the problem, align the work, and build systems that keep holding after launch."
      />

      <div class="leverage-list">
        {
          hiringProfiles.map((profile, i) => (
            <article
              class={`leverage-item animate-fade-up delay-${Math.min((i + 1) * 100, 400)}`}
            >
              <p class="leverage-item__kicker text-mono">
                Focus {String(i + 1).padStart(2, "0")}
              </p>
              <h3 class="leverage-item__title">{profile.title}</h3>
              <p class="leverage-item__desc">{profile.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       HOW I LEAD PROGRAMS
  ═══════════════════════════════════════════ -->
  <section class="section section--alt">
    <div class="container container--page">
      <SectionHeader
        label="// HOW I LEAD PROGRAMS"
        title="The Operating Model, In Brief"
        subtitle="This is the short version of how I approach director-level program work before you dive into the full methodology page."
      />

      <div class="principles-list">
        {
          homePrinciples.map((principle) => (
            <article class="principle">
              <span class="principle__num text-mono text-accent">
                {principle.num}
              </span>
              <p class="principle__text">{principle.text}</p>
            </article>
          ))
        }
      </div>

      <div class="section-actions">
        <a href={toBasePath("/how-i-work")} class="btn btn-outline"
          >See the full operating model</a
        >
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CORE STRENGTHS
  ═══════════════════════════════════════════ -->
  <section class="section capabilities-section">
    <div class="container container--page">
      <SectionHeader
        label="// CAPABILITIES"
        title="How I Add Value"
        subtitle="The through-line is consistent across domains: systems thinking, execution clarity, technical leverage, and leadership that holds under pressure."
      />

      <div class="capability-list">
        {
          featuredStrengths.map((strength, i) => (
            <article
              class={`capability-item animate-fade-up delay-${Math.min((i + 1) * 100, 400)}`}
            >
              <span class="capability-item__icon" aria-hidden="true">
                {strength.icon}
              </span>
              <h3 class="capability-item__title">{strength.title}</h3>
              <p class="capability-item__desc">{strength.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PROJECT SCOPE
  ═══════════════════════════════════════════ -->
  <section class="section section--alt">
    <div class="container container--page">
      <SectionHeader
        label="// PROJECT SCOPE"
        title="The projects are evidence, not decoration"
        subtitle="Each lane connects back to the same operating habit: make the work legible, make ownership explicit, and build the system people need when the stakes are real."
      />

      <div class="project-focus-list">
        {
          projectFocusAreas.map((area, i) => (
            <article class="project-focus-item">
              <div>
                <p class="project-focus-item__index text-mono">
                  {String(i + 1).padStart(2, "0")}
                </p>
                <h3>{area.title}</h3>
                <p>{area.text}</p>
              </div>
              <a href={toBasePath(area.href)} class="project-focus-item__proof">
                <span class="text-mono">Proof</span>
                {area.proof}
              </a>
            </article>
          ))
        }
      </div>

      <div class="project-focus-actions">
        <a href={toBasePath("/projects")} class="btn btn-primary"
          >Explore Project Portfolio</a
        >
        <a href={toBasePath("/career")} class="btn btn-outline"
          >View Career Context</a
        >
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CAREER TIMELINE HUB
  ═══════════════════════════════════════════ -->
  <section class="section">
    <div class="container container--page">
      <SectionHeader
        label="// CAREER ARC"
        title="See the progression behind the outcomes"
        subtitle="The career page now brings the full arc together, from frontline support and military operations to senior program leadership, community systems, and live-event execution."
      />

      <div class="career-hub-card panel">
        <p class="career-hub-card__copy text-muted">
          Use narrative view for the director-level story, gantt for role and
          project overlap, or scroll for the full progression in one pass.
        </p>
        <div class="career-hub-card__actions">
          <a href={toBasePath("/career?view=narrative")} class="btn btn-primary"
            >Open Narrative View</a
          >
          <a href={toBasePath("/career?view=gantt")} class="btn btn-outline"
            >Open Gantt View</a
          >
          <a href={toBasePath("/career?view=scroll")} class="btn btn-ghost"
            >Open Scroll View</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PERSONAL INTRO
  ═══════════════════════════════════════════ -->
  <section class="section section--alt">
    <div class="container container--page">
      <div class="intro-grid">
        <div class="intro__text">
          <p class="section-label">// BACKGROUND</p>
          <h2>Why this perspective holds up in real environments</h2>
          <p>
            My background is broad on purpose. Military service taught me how to
            lead under pressure, Ubisoft taught me how large organizations
            actually move work, and community and event systems gave me places
            to keep building beyond formal job boundaries.
          </p>
          <p>
            That mix is why I tend to operate well above a narrow title line. I
            am comfortable in the strategy layer, the execution layer, and the
            system-design layer at the same time.
          </p>
          <p>
            If you want the fuller version, the About page explains where that
            operating style came from and why I keep getting pulled toward
            systems that need to be clarified, rebuilt, or scaled.
          </p>
          <a href={toBasePath("/about")} class="btn btn-outline intro__action"
            >Read the background</a
          >
        </div>

        <div class="intro__stats">
          {
            homeStats.map((stat) => (
              <div class="stat-card">
                <span class="stat-card__value">{stat.value}</span>
                <span class="stat-card__label">{stat.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CTA
  ═══════════════════════════════════════════ -->
  <section class="section section--sm">
    <div class="container">
      <div class="cta-panel">
        <p class="section-label">// WORK TOGETHER</p>
        <h2>Let's build something together.</h2>
        <p>
          I'm open to roles in technical program management, operations
          leadership, and innovation-focused systems work. If you're building
          something complex and need someone who can align people, process, and
          execution, reach out.
        </p>
        <div class="cta-panel__actions">
          <a href={toBasePath("/contact")} class="btn btn-primary"
            >Get in Touch</a
          >
          <a href={toBasePath("/now")} class="btn btn-ghost"
            >What I'm Working On</a
          >
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-4xl);
    min-height: calc(100vh - var(--nav-height));
    display: flex;
    align-items: center;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    gap: var(--space-3xl);
    align-items: center;
  }

  .hero__eyebrow {
    margin-bottom: var(--space-md);
  }

  .hero__role-line {
    margin: 0 0 var(--space-md);
    color: var(--color-accent);
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__headline {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.15;
    margin-bottom: var(--space-lg);
  }

  .hero__headline-accent {
    color: var(--color-accent);
    position: relative;
  }

  .hero__subtext {
    font-size: var(--font-size-lead);
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 52ch;
    margin-bottom: var(--space-md);
  }

  .hero__supporting-text {
    color: var(--color-text);
    max-width: 56ch;
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .hero__proof-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: 0 0 var(--space-xl);
    padding: 0;
  }

  .hero__proof-pill {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-accent-dim);
    color: var(--color-text);
    font-size: var(--font-size-meta);
    line-height: 1.5;
  }

  .hero__evidence {
    min-height: 0;
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    position: relative;
    background:
      linear-gradient(180deg, var(--color-accent-dim), transparent 36%),
      var(--color-bg-secondary);
  }

  .hero__evidence-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    position: relative;
    z-index: 1;
  }

  .hero__evidence-label {
    margin: 0;
    font-size: var(--font-size-label);
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
  }

  .hero__evidence-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    font-size: var(--font-size-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-heading);
    background: var(--color-accent-dim);
  }

  .hero__evidence-status::before {
    content: "";
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--color-success);
    box-shadow: var(--glow-accent);
  }

  .hero__evidence-intro {
    position: relative;
    z-index: 1;
  }

  .hero__evidence-title {
    margin: 0 0 var(--space-sm);
    font-size: var(--font-size-card-title);
    color: var(--color-text-heading);
  }

  .hero__evidence-copy {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .hero__evidence-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .hero__evidence-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-bg-card), var(--color-bg) 24%);
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .hero__evidence-card:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-2px);
  }

  .hero__evidence-value {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    color: var(--color-text-heading);
  }

  .hero__evidence-card-label {
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero__evidence-card-detail {
    margin: 0;
    font-size: var(--font-size-meta);
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .leverage-list {
    display: grid;
    gap: var(--space-lg);
  }

  .leverage-item {
    display: grid;
    grid-template-columns: minmax(9rem, 0.35fr) minmax(12rem, 0.55fr) 1fr;
    gap: var(--space-lg);
    align-items: start;
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .leverage-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .leverage-item__kicker {
    margin: 0;
    font-size: var(--font-size-label);
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .leverage-item__title {
    font-size: var(--font-size-card-title);
    color: var(--color-text-heading);
    margin: 0;
  }

  .leverage-item__desc {
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.7;
  }

  .section-actions {
    margin-top: var(--space-2xl);
  }

  /* ── Strengths ── */
  .capabilities-section {
    padding-block: var(--space-lg);
  }

  .capabilities-section :global(.section-header) {
    margin-bottom: var(--space-lg);
  }

  .capability-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm) var(--space-xl);
  }

  .capability-item {
    display: grid;
    grid-template-columns: 1.3rem minmax(0, 1fr);
    grid-template-areas:
      "icon title"
      ". desc";
    column-gap: var(--space-sm);
    row-gap: var(--space-xs);
    align-items: baseline;
    padding-block: var(--space-sm);
    border-top: 1px solid var(--color-border);
  }

  .capability-item__icon {
    display: block;
    grid-area: icon;
    color: var(--color-accent);
    font-size: 0.9rem;
    line-height: 1.2;
  }

  .capability-item__title {
    grid-area: title;
    font-size: var(--font-size-card-title);
    margin: 0;
    color: var(--color-text-heading);
  }

  .capability-item__desc {
    grid-area: desc;
    font-size: var(--font-size-body-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* ── Principles ── */
  .principles-list {
    display: grid;
    gap: var(--space-md);
  }

  .principle {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-lg);
    align-items: start;
    padding-block: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .principle:last-child {
    border-bottom: none;
  }

  .principle__text {
    color: var(--color-text);
    line-height: 1.65;
    margin: 0;
  }

  /* ── Project focus ── */
  .project-focus-list {
    display: grid;
    gap: var(--space-md);
  }

  .project-focus-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.42fr);
    gap: var(--space-xl);
    align-items: center;
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .project-focus-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .project-focus-item__index {
    margin: 0 0 var(--space-sm);
    color: var(--color-accent);
    font-size: var(--font-size-label);
    letter-spacing: 0.08em;
  }

  .project-focus-item h3 {
    margin-bottom: var(--space-sm);
    color: var(--color-text-heading);
    font-size: var(--font-size-card-title);
  }

  .project-focus-item p {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .project-focus-item__proof {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    background: var(--color-bg-card);
    text-decoration: none;
  }

  .project-focus-item__proof span {
    color: var(--color-accent);
    font-size: var(--font-size-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-focus-item__proof:hover,
  .project-focus-item__proof:focus-visible {
    border-color: var(--color-border-strong);
    color: var(--color-text-heading);
  }

  .project-focus-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-2xl);
  }

  /* ── Intro ── */
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(260px, 0.9fr);
    gap: var(--space-2xl);
    align-items: start;
  }

  .intro__text h2 {
    margin-bottom: var(--space-lg);
  }

  .intro__action {
    margin-top: var(--space-md);
  }

  .intro__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .stat-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .stat-card__value {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
  }

  .stat-card__label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .career-hub-card {
    display: grid;
    gap: var(--space-md);
  }

  .career-hub-card__copy {
    margin: 0;
  }

  .career-hub-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* ── CTA ── */
  .cta-panel {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-xl);
    padding: var(--space-3xl);
    text-align: center;
    position: relative;
    overflow: hidden;
    box-shadow: var(--glow-accent);
  }

  .cta-panel h2 {
    margin-block: var(--space-md);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .cta-panel p {
    color: var(--color-text-muted);
    max-width: 55ch;
    margin-inline: auto;
    line-height: 1.7;
  }

  .cta-panel__actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-xl);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .hero__signal {
      min-height: auto;
    }

    .hero {
      min-height: auto;
      padding-block: var(--space-3xl);
    }

    .intro-grid {
      grid-template-columns: 1fr;
    }

    .leverage-item,
    .project-focus-item {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .capability-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero__evidence-grid {
      grid-template-columns: 1fr;
    }

    .hero__evidence-head {
      align-items: flex-start;
