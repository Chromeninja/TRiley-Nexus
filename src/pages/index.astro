---
// index.astro: Homepage
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { homePrinciples, homeStats } from "../data/homeContent";
import { coreStrengths } from "../data/skills";
import { toBasePath } from "../utils/paths";
import { siteConfig } from "../data/siteConfig";

const homeHero = siteConfig.home.hero;
const hiringProfiles = siteConfig.home.hiringProfiles;
const featuredEvidence = siteConfig.home.featuredEvidence;
const featuredStrengths = coreStrengths.filter(s => s.title !== "Star Citizen Operations").slice(0, 4);

const projectFocusAreas = [
  {
    title: "Event management",
    text: "Live-event systems, staffing models, check-in operations, runbooks, and the decision structure needed when people are moving in real time.",
  },
  {
    title: "Leadership",
    text: "Director-level ownership across teams, communities, vendors, volunteers, and stakeholders with clear accountability for outcomes.",
  },
  {
    title: "Program management",
    text: "Roadmaps, risk management, launch readiness, platform support, production pipelines, and cross-functional delivery across overlapping workstreams.",
  },
  {
    title: "Community",
    text: "Community operations, organization leadership, large-scale coordination, and event production built around clear governance and repeatable systems.",
  },
];
---

<Layout
  title={siteConfig.site.baseTitle}
  description={siteConfig.home.metaDescription}
>
  <!-- ═══════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════ -->
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div class="hero__content animate-fade-up">
          <p class="hero__eyebrow section-label">{homeHero.eyebrow}</p>
          <p class="hero__role-line text-mono">{homeHero.roleLine}</p>
          <h1 class="hero__headline">
            {homeHero.headlineLead}
            <span class="hero__headline-accent">
              {homeHero.headlineAccent}</span
            >
            {homeHero.headlineTail}
          </h1>
          <p class="hero__subtext">
            {homeHero.subtext}
          </p>
          <ul class="hero__proof-list" aria-label="Selected proof points">
            {
              homeHero.proofPoints.map((point) => (
                <li class="hero__proof-pill">{point}</li>
              ))
            }
          </ul>
          <div class="hero__actions">
            <a
              href={toBasePath(homeHero.primaryAction.href)}
              class="btn btn-primary"
              >{homeHero.primaryAction.label}</a
            >
            <a
              href={toBasePath(homeHero.secondaryAction.href)}
              class="btn btn-outline"
              >{homeHero.secondaryAction.label}</a
            >
          </div>
        </div>

        <div
          class="hero__evidence panel animate-fade-up delay-200"
          aria-label="Selected proof of impact"
        >
          <div class="hero__evidence-head">
            <p class="hero__evidence-label text-mono">
              EXECUTIVE SNAPSHOT // SELECTED PROOF
            </p>
            <span class="hero__evidence-status">Verified</span>
          </div>

          <div class="hero__evidence-intro">
            <h2 class="hero__evidence-title">
              Backed by shipped work.
            </h2>
            <p class="hero__evidence-copy">
              The pattern across my career is consistent: diagnose quickly,
              align the work, build the system, and leave the organization with
              more leverage than it had before.
            </p>
          </div>

          <div class="hero__evidence-grid">
            {
              featuredEvidence.map((item) => (
                <a class="hero__evidence-card" href={toBasePath(item.href)}>
                  <span class="hero__evidence-value">{item.value}</span>
                  <span class="hero__evidence-card-label">{item.label}</span>
                  <p class="hero__evidence-card-detail">{item.detail}</p>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <!-- Background decoration -->
    <div class="hero__bg-grid" aria-hidden="true"></div>
  </section>

  <!-- ═══════════════════════════════════════════
       WHAT I SOLVE
  ═══════════════════════════════════════════ -->
  <section class="section">
    <div class="container container--page">
      <SectionHeader
        label="// WHAT I SOLVE"
        title="Where I Create Leverage"
        subtitle="I am most useful when an organization needs one operator who can clarify the problem, align the work, and build systems that keep holding after launch."
      />

      <div class="grid-3 profile-grid">
        {
          hiringProfiles.map((profile, i) => (
            <div
              class={`profile-card animate-fade-up delay-${Math.min((i + 1) * 100, 400)}`}
            >
              <p class="profile-card__kicker text-mono">Focus {i + 1}</p>
              <h3 class="profile-card__title">{profile.title}</h3>
              <p class="profile-card__desc">{profile.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       HOW I LEAD PROGRAMS
  ═══════════════════════════════════════════ -->
  <section class="section section--alt">
    <div class="container container--page">
      <SectionHeader
        label="// HOW I LEAD PROGRAMS"
        title="The Operating Model, In Brief"
        subtitle="This is the short version of how I approach director-level program work before you dive into the full methodology page."
      />

      <div class="principles-list principles-list--grid">
        {
          homePrinciples.map((principle) => (
            <div class="principle principle--card">
              <span class="principle__num text-mono text-accent">
                {principle.num}
              </span>
              <p class="principle__text">{principle.text}</p>
            </div>
          ))
        }
      </div>

      <div class="section-actions">
        <a href={toBasePath("/how-i-work")} class="btn btn-outline"
          >See the full operating model</a
        >
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CORE STRENGTHS
  ═══════════════════════════════════════════ -->
  <section class="section">
    <div class="container container--page">
      <SectionHeader
        label="// CAPABILITIES"
        title="How I Add Value"
        subtitle="Event operations, program management, community systems, and the tools that enable execution."
      />

      <div class="grid-3 strengths-grid">
        {
          featuredStrengths.map((strength, i) => (
            <div
              class={`strength-card animate-fade-up delay-${Math.min((i + 1) * 100, 400)}`}
            >
              <span class="strength-card__icon" aria-hidden="true">
                {strength.icon}
              </span>
              <h3 class="strength-card__title">{strength.title}</h3>
              <p class="strength-card__desc">{strength.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PROJECT FOCUS
  ═══════════════════════════════════════════ -->
  <section class="section section--alt">
    <div class="container container--page">
      <SectionHeader
        label="// PROJECT SCOPE"
        title="The work clusters around four lanes"
        subtitle="The projects on this site are broad, but they share a practical center: leading complex work, building operational systems, and helping groups execute under real constraints."
      />

      <div class="project-focus-grid">
        {
          projectFocusAreas.map((area, i) => (
            <article
              class={`project-focus-card animate-fade-up delay-${Math.min((i + 1) * 100, 400)}`}
            >
              <span class="project-focus-card__index text-mono">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3>{area.title}</h3>
              <p>{area.text}</p>
            </article>
          ))
        }
      </div>

      <div class="project-focus-actions">
        <a href={toBasePath("/projects")} class="btn btn-primary"
          >Explore Project Portfolio</a
        >
        <a href={toBasePath("/career")} class="btn btn-outline"
          >View Career Context</a
        >
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CAREER TIMELINE HUB
  ═══════════════════════════════════════════ -->
  <section class="section section--alt">
    <div class="container container--page">
      <SectionHeader
        label="// CAREER ARC"
        title="See the progression behind the outcomes"
        subtitle="Browse the full arc — from military roots to senior program leadership."
      />

      <div class="career-hub-card panel">
        <div class="career-hub-card__actions">
          <a href={toBasePath("/career?view=narrative")} class="btn btn-primary"
            >Open Narrative View</a
          >
          <a href={toBasePath("/career?view=gantt")} class="btn btn-outline"
            >Open Gantt View</a
          >
          <a href={toBasePath("/career?view=scroll")} class="btn btn-ghost"
            >Open Scroll View</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PERSONAL INTRO
  ═══════════════════════════════════════════ -->
  <section class="section section--alt">
    <div class="container container--page">
      <div class="intro-grid">
        <div class="intro__text">
          <p class="section-label">// BACKGROUND</p>
          <span class="accent-line"></span>
          <h2>Why this perspective holds up in real environments</h2>
          <p>
            That mix is why I tend to operate well above a narrow title line. I
            am comfortable in the strategy layer, the execution layer, and the
            system-design layer at the same time, especially when multiple
            projects are moving at once.
          </p>
          <a
            href={toBasePath("/about")}
            class="btn btn-outline intro__action">Read the background</a
          >
        </div>

        <div class="intro__stats">
          {
            homeStats.map((stat) => (
              <div class="stat-card">
                <span class="stat-card__value">{stat.value}</span>
                <span class="stat-card__label">{stat.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CTA
  ═══════════════════════════════════════════ -->
  <section class="section section--sm">
    <div class="container container--reading">
      <div class="cta-panel">
        <p class="section-label">// WORK TOGETHER</p>
        <h2>Let's build something together.</h2>
        <p>
          If you need someone who can own scope, align teams, and turn complex
          work into execution, reach out.
        </p>
        <div class="cta-panel__actions">
          <a href={toBasePath("/contact")} class="btn btn-primary"
            >Get in Touch</a
          >
          <a href={toBasePath("/now")} class="btn btn-ghost"
            >What I'm Working On</a
          >
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-4xl);
    min-height: calc(100vh - var(--nav-height));
    display: flex;
    align-items: center;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    gap: var(--space-3xl);
    align-items: center;
  }

  .hero__eyebrow {
    margin-bottom: var(--space-md);
  }

  .hero__role-line {
    margin: 0 0 var(--space-md);
    color: var(--color-accent);
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__headline {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.15;
    margin-bottom: var(--space-lg);
  }

  .hero__headline-accent {
    color: var(--color-accent);
    position: relative;
  }

  .hero__subtext {
    font-size: var(--font-size-lead);
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 52ch;
    margin-bottom: var(--space-md);
  }

  .hero__supporting-text {
    color: var(--color-text);
    max-width: 56ch;
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .hero__proof-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: 0 0 var(--space-xl);
    padding: 0;
  }

  .hero__proof-pill {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: rgba(87, 166, 255, 0.08);
    color: var(--color-text);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .hero__evidence {
    min-height: 0;
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    position: relative;
    background:
      radial-gradient(circle at top, rgba(87, 166, 255, 0.18), transparent 35%),
      radial-gradient(
        circle at 85% 20%,
        rgba(34, 211, 238, 0.14),
        transparent 28%
      ),
      linear-gradient(145deg, rgba(6, 12, 24, 0.94), rgba(10, 20, 40, 0.94));
  }

  .hero__evidence::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(87, 166, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(87, 166, 255, 0.05) 1px, transparent 1px);
    background-size: 30px 30px;
    mask-image: radial-gradient(circle at center, black 40%, transparent 100%);
    pointer-events: none;
  }

  .hero__evidence-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    position: relative;
    z-index: 1;
  }

  .hero__evidence-label {
    margin: 0;
    font-size: var(--font-size-label);
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
  }

  .hero__evidence-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    border: 1px solid rgba(87, 166, 255, 0.28);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    font-size: var(--font-size-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-heading);
    background: rgba(87, 166, 255, 0.08);
  }

  .hero__evidence-status::before {
    content: "";
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--color-success);
    box-shadow: 0 0 14px rgba(87, 166, 255, 0.55);
  }

  .hero__evidence-intro {
    position: relative;
    z-index: 1;
  }

  .hero__evidence-title {
    margin: 0 0 var(--space-sm);
    font-size: var(--font-size-card-title);
    color: var(--color-text-heading);
  }

  .hero__evidence-copy {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .hero__evidence-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .hero__evidence-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-md);
    border: 1px solid rgba(87, 166, 255, 0.16);
    border-radius: var(--radius-md);
    background: rgba(6, 13, 18, 0.68);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.02);
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .hero__evidence-card:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-2px);
  }

  .hero__evidence-value {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    color: var(--color-text-heading);
  }

  .hero__evidence-card-label {
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero__evidence-card-detail {
    margin: 0;
    font-size: var(--font-size-body-sm);
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .profile-grid {
    align-items: stretch;
  }

  .profile-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
  }

  .profile-card__kicker {
    margin: 0 0 var(--space-md);
    font-size: var(--font-size-label);
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .profile-card__title {
    font-size: var(--font-size-card-title);
    color: var(--color-text-heading);
    margin-bottom: var(--space-sm);
  }

  .profile-card__desc {
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.7;
  }

  .principles-list--grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .principle--card {
    height: 100%;
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .section-actions {
    margin-top: var(--space-2xl);
  }

  .hero__bg-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgba(87, 166, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(34, 211, 238, 0.03) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(
      ellipse 80% 80% at 50% 50%,
      black 40%,
      transparent 100%
    );
  }

  /* ── Strengths ── */
  .strength-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .strength-card:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--glow-accent);
  }

  .strength-card__icon {
    display: block;
    font-size: 1.5rem;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
    line-height: 1;
  }

  .strength-card__title {
    font-size: var(--font-size-card-title);
    margin-bottom: var(--space-sm);
    color: var(--color-text-heading);
  }

  .strength-card__desc {
    font-size: var(--font-size-body-sm);
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
  }

  /* ── Project Focus ── */
  .project-focus-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .project-focus-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .project-focus-card__index {
    display: block;
    margin-bottom: var(--space-md);
    color: var(--color-accent);
    font-size: var(--font-size-label);
    letter-spacing: 0.08em;
  }

  .project-focus-card h3 {
    margin-bottom: var(--space-sm);
    color: var(--color-text-heading);
    font-size: var(--font-size-card-title);
  }

  .project-focus-card p {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.65;
    font-size: var(--font-size-body-sm);
  }

  .project-focus-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-2xl);
  }

  /* ── Principles ── */
  .principles-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .principle {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-md);
    align-items: start;
  }

  .principle:last-child {
    border-bottom: none;
  }

  .principle__text {
    color: var(--color-text);
    line-height: 1.65;
    margin: 0;
  }

  /* ── Intro ── */
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(260px, 0.9fr);
    gap: var(--space-2xl);
    align-items: start;
  }

  .intro__text h2 {
    margin-bottom: var(--space-lg);
  }

  .intro__action {
    margin-top: var(--space-md);
  }

  .intro__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .stat-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .stat-card__value {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
  }

  .stat-card__label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .career-hub-card {
    display: grid;
    gap: var(--space-md);
  }

  .career-hub-card__copy {
    margin: 0;
  }

  .career-hub-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* ── CTA ── */
  .cta-panel {
    background: var(--color-bg-card);
    border: 1px solid rgba(0, 212, 255, 0.2);
    border-radius: var(--radius-xl);
    padding: var(--space-3xl);
    text-align: center;
    position: relative;
    overflow: hidden;
    box-shadow: var(--glow-accent);
  }

  .cta-panel h2 {
    margin-block: var(--space-md);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .cta-panel p {
    color: var(--color-text-muted);
    max-width: 55ch;
    margin-inline: auto;
    line-height: 1.7;
  }

  .cta-panel__actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-xl);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .hero__signal {
      min-height: auto;
    }

    .hero {
      min-height: auto;
      padding-block: var(--space-3xl);
    }

    .intro-grid {
      grid-template-columns: 1fr;
    }

    .project-focus-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .hero__signal {
      padding: var(--space-lg);
    }

    .hero__signal-head {
      flex-direction: column;
      align-items: flex-start;
    }

