---
// index.astro: Homepage
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { homePrinciples, homeStats } from "../data/homeContent";
import { coreStrengths } from "../data/skills";
import { toBasePath } from "../utils/paths";
import { siteConfig } from "../data/siteConfig";

const homeHero = siteConfig.home.hero;
const hiringProfiles = siteConfig.home.hiringProfiles;
const featuredHighlights = siteConfig.home.featuredHighlights;
const heroProofItems = homeHero.proofPoints ?? homeHero.quickNotes ?? [];
const featuredStrengths = coreStrengths.filter((strength) =>
  [
    "Event Management",
    "Star Citizen Operations",
    "Operating Systems",
    "Leadership Under Pressure",
  ].includes(strength.title),
);
const helpAreaLabels = [
  "Program momentum",
  "Day-to-day systems",
  "Useful tooling",
];
const strengthModes = ["Clarify", "Coordinate", "Systemize", "Hold"];
const projectFocusAreas = [
  {
    title: "Event operations systems",
    text: "Offline-first platforms, check-in tooling, staff visibility, and real-time decision support built for live events where the internet is unreliable and errors have consequences.",
  },
  {
    title: "Community platforms and governance",
    text: "Discord bot systems, verification workflows, role management, analytics, and governance design for large-scale communities that need to run without constant manual intervention.",
  },
  {
    title: "People and live event leadership",
    text: "Director-level ownership across volunteer coordinators, vendors, and stakeholders when schedules are live, people are moving, and someone has to hold the operating picture.",
  },
  {
    title: "Military operations under pressure",
    text: "ATC, landing zone safety, and expeditionary airfield operations built the execution habits that carry into every high-stakes environment: calm, systematic, and hazard-aware.",
  },
];
---

<Layout
  title={siteConfig.site.baseTitle}
  description={siteConfig.home.metaDescription}
>
  <!-- ═══════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════ -->
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div class="hero__content animate-fade-up">
          <p class="hero__eyebrow section-label">{homeHero.eyebrow}</p>
          <p class="hero__role-line text-mono">{homeHero.roleLine}</p>
          <h1 class="hero__headline">
            {homeHero.headlineLead}
            <span class="hero__headline-accent">
              {homeHero.headlineAccent}</span
            >
            {homeHero.headlineTail}
          </h1>
          <p class="hero__subtext">
            {homeHero.subtext}
          </p>
          {
            homeHero.supportingText && (
              <p class="hero__supporting-text">{homeHero.supportingText}</p>
            )
          }
          <ul class="hero__quick-notes" aria-label="Selected proof points">
            {
              heroProofItems.map((point) => (
                <li class="hero__quick-note">{point}</li>
              ))
            }
          </ul>
          <div class="hero__actions">
            <a
              href={toBasePath(homeHero.primaryAction.href)}
              class="btn btn-primary">{homeHero.primaryAction.label}</a
            >
            <a
              href={toBasePath(homeHero.secondaryAction.href)}
              class="btn btn-outline">{homeHero.secondaryAction.label}</a
            >
          </div>
        </div>

        <div
          class="hero__highlights animate-fade-up delay-200"
          aria-label="A few career highlights"
        >
          <div class="hero__highlights-head">
            <p class="hero__highlights-label text-mono">
              A FEW THINGS I'VE BUILT
            </p>
          </div>

          <div class="hero__highlights-intro">
            <h2 class="hero__highlights-title">
              A wide mix of work, tied together by follow-through.
            </h2>
            <p class="hero__highlights-copy">
              Across military service, games, community work, and live events, I
              tend to do the same useful thing: find the messy middle, make it
              easier to understand, and help people move.
            </p>
          </div>

          <div class="hero__highlights-grid">
            {
              featuredHighlights.map((item) => (
                <a
                  class="hero__highlights-card"
                  href={toBasePath(item.href)}
                  aria-label={`${item.label}: ${item.detail}`}
                >
                  <span class="hero__highlights-value">{item.value}</span>
                  <span class="hero__highlights-card-label">{item.label}</span>
                  <p class="hero__highlights-card-detail">{item.detail}</p>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       WHAT I SOLVE
  ═══════════════════════════════════════════ -->
  <section class="section help-section">
    <div class="container">
      <SectionHeader
        label="// WHAT I SOLVE"
        title="Where I Tend To Help"
        subtitle="I am at my best when the work is important, a little tangled, and in need of someone who can make the path feel doable."
      />

      <div class="profile-list">
        {
          hiringProfiles.map((profile, i) => (
            <article
              class={`profile-card animate-fade-up delay-${Math.min((i + 1) * 100, 400)}`}
            >
              <p class="profile-card__kicker text-mono">
                {helpAreaLabels[i] ?? `Focus ${i + 1}`}
              </p>
              <div class="profile-card__body">
                <h3 class="profile-card__title">{profile.title}</h3>
                <p class="profile-card__desc">{profile.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
      HOW I WORK
  ═══════════════════════════════════════════ -->
  <section class="section section--band">
    <div class="container">
      <SectionHeader
        label="// HOW I WORK"
        title="How I Usually Approach the Work"
        subtitle="A short version of how I move from fuzzy problem to shared plan, useful system, and cleaner handoff."
      />

      <ol class="principles-list">
        {
          homePrinciples.map((principle) => (
            <li class="principle">
              <span class="principle__num text-mono" aria-hidden="true">
                {principle.num}
              </span>
              <p class="principle__text">{principle.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="section-actions">
        <a href={toBasePath("/how-i-work")} class="btn btn-outline"
          >See how I work</a
        >
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CORE STRENGTHS
  ═══════════════════════════════════════════ -->
  <section class="section">
    <div class="container container--page">
      <SectionHeader
        label="// CAPABILITIES"
        title="How I Add Value"
        subtitle="Event operations, program management, community systems, and the tools that enable execution."
      />

      <div class="strengths-list">
        {
          featuredStrengths.map((strength, i) => (
            <article
              class={`strength-row animate-fade-up delay-${Math.min((i + 1) * 100, 400)}`}
            >
              <span class="strength-row__mode text-mono">
                {strengthModes[i] ?? "Build"}
              </span>
              <span class="strength-row__icon" aria-hidden="true">
                {strength.icon}
              </span>
              <div class="strength-row__body">
                <h3 class="strength-row__title">{strength.title}</h3>
                <p class="strength-row__desc">{strength.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PROJECT FOCUS
  ═══════════════════════════════════════════ -->
  <section class="section section--alt">
    <div class="container container--page">
      <SectionHeader
        label="// PROJECT SCOPE"
        title="The work clusters around four lanes"
        subtitle="The projects on this site are broad, but they share a practical center: leading complex work, building operational systems, and helping groups execute under real constraints."
      />

      <div class="project-focus-grid">
        {
          projectFocusAreas.map((area, i) => (
            <article
              class={`project-focus-card animate-fade-up delay-${Math.min((i + 1) * 100, 400)}`}
            >
              <span class="project-focus-card__index text-mono">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3>{area.title}</h3>
              <p>{area.text}</p>
            </article>
          ))
        }
      </div>

      <div class="project-focus-actions">
        <a href={toBasePath("/projects")} class="btn btn-primary"
          >Explore Project Portfolio</a
        >
        <a href={toBasePath("/career")} class="btn btn-outline"
          >View Career Context</a
        >
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CAREER TIMELINE HUB
  ═══════════════════════════════════════════ -->
  <section class="section section--band career-section">
    <div class="container">
      <SectionHeader
        label="// CAREER ARC"
        title="See How The Work Connects"
        subtitle="The career page pulls the whole path together, from frontline support and military operations to program leadership, community systems, and live-event work."
      />

      <div class="career-hub-card">
        <p class="career-hub-card__label text-mono">
          Three ways to browse the same body of work
        </p>
        <p class="career-hub-card__copy text-muted">
          Use narrative view for the story, gantt for role and project overlap,
          or scroll for the full progression in one pass.
        </p>

        <div class="career-hub-card__actions">
          <a href={toBasePath("/career?view=narrative")} class="btn btn-primary"
            >Open Narrative View</a
          >
          <a href={toBasePath("/career?view=gantt")} class="btn btn-outline"
            >Open Gantt View</a
          >
          <a href={toBasePath("/career?view=scroll")} class="btn btn-ghost"
            >Open Scroll View</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PERSONAL INTRO
  ═══════════════════════════════════════════ -->
  <section class="section section--band intro-section">
    <div class="container">
      <div class="intro-grid">
        <div class="intro__text">
          <p class="section-label">// BACKGROUND</p>
          <span class="accent-line"></span>
          <h2>Why this background fits messy work</h2>
          <p>
            My background is broad on purpose. Military service taught me how to
            lead under pressure, Ubisoft taught me how large organizations
            actually move work, and community and event systems gave me places
            to keep building beyond formal job boundaries.
          </p>
          <p>
            That mix is why I tend to operate well above a narrow title line. I
            am comfortable in the strategy layer, the execution layer, and the
            system-design layer at the same time, especially when multiple
            projects are moving at once.
          </p>
          <p>
            If you want the fuller version, the About page explains where that
            operating style came from and why I keep getting pulled toward
            systems that need to be clarified, rebuilt, or scaled.
          </p>
          <a href={toBasePath("/about")} class="btn btn-outline intro__action"
            >Read the background</a
          >
        </div>

        <div class="intro__stats">
          {
            homeStats.map((stat) => (
              <div class="stat-card">
                <span class="stat-card__value">{stat.value}</span>
                <span class="stat-card__label">{stat.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CTA
  ═══════════════════════════════════════════ -->
  <section class="section section--sm">
    <div class="container container--reading">
      <div class="cta-panel">
        <p class="section-label">// WORK TOGETHER</p>
        <h2>Let's build something together.</h2>
        <p>
          If you need someone who can own scope, align teams, and turn complex
          work into execution, reach out.
        </p>
        <div class="cta-panel__actions">
          <a href={toBasePath("/contact")} class="btn btn-primary"
            >Get in Touch</a
          >
          <a href={toBasePath("/now")} class="btn btn-ghost"
            >What I'm Working On</a
          >
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .section--band {
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-bg-secondary), transparent 8%),
        color-mix(in srgb, var(--color-bg), transparent 16%)
      ),
      var(--color-bg-secondary);
    border-block: 1px solid var(--color-border);
  }

  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-4xl);
    min-height: calc(100vh - var(--nav-height));
    display: flex;
    align-items: center;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.95fr);
    gap: var(--space-3xl);
    align-items: center;
  }

  .hero__eyebrow {
    margin-bottom: var(--space-md);
  }

  .hero__role-line {
    margin: 0 0 var(--space-md);
    color: var(--color-accent);
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__headline {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.15;
    margin-bottom: var(--space-lg);
  }

  .hero__headline-accent {
    color: var(--color-accent);
    position: relative;
  }

  .hero__subtext {
    font-size: var(--font-size-lead);
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 52ch;
    margin-bottom: var(--space-md);
  }

  .hero__supporting-text {
    color: var(--color-text);
    max-width: 56ch;
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .hero__quick-notes {
    display: grid;
    gap: var(--space-xs);
    margin: 0 0 var(--space-xl);
    padding-left: 1.15rem;
    color: var(--color-text-muted);
  }

  .hero__quick-note {
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .hero__highlights {
    min-height: 0;
    padding: var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    position: relative;
    border-block: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-bg-card), transparent 8%),
        color-mix(in srgb, var(--color-bg-secondary), transparent 18%)
      ),
      var(--color-bg-card);
    box-shadow: var(--shadow-card);
  }

  .hero__highlights-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    position: relative;
    z-index: 1;
  }

  .hero__highlights-label {
    margin: 0;
    font-size: var(--font-size-label);
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
  }

  .hero__highlights-intro {
    position: relative;
    z-index: 1;
  }

  .hero__highlights-title {
    margin: 0 0 var(--space-sm);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    color: var(--color-text-heading);
  }

  .hero__highlights-copy {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .hero__highlights-grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-sm);
  }

  .hero__highlights-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(5.5rem, auto) minmax(0, 1fr);
    grid-template-areas:
      "value label"
      "value detail";
    column-gap: var(--space-lg);
    row-gap: var(--space-xs);
    padding: var(--space-md);
    border-top: 1px solid var(--color-border);
    background: transparent;
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      background var(--transition-fast),
      transform var(--transition-fast);
  }

  .hero__highlights-card:first-child {
    border-top: 0;
  }

  .hero__highlights-card:hover {
    background: color-mix(in srgb, var(--color-accent), transparent 94%);
    border-color: var(--color-border-strong);
    transform: translateY(-2px);
  }

  .hero__highlights-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: var(--space-xs);
  }

  .hero__highlights-value {
    grid-area: value;
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3vw, 2.65rem);
    line-height: 1;
    color: var(--color-text-heading);
  }

  .hero__highlights-card-label {
    grid-area: label;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero__highlights-card-detail {
    grid-area: detail;
    margin: 0;
    font-size: 0.86rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .profile-list {
    display: grid;
    gap: var(--space-sm);
  }

  .profile-card {
    display: grid;
    grid-template-columns: minmax(8rem, 0.28fr) minmax(0, 1fr);
    gap: var(--space-xl);
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .profile-card:first-child {
    border-top-color: var(--color-border-strong);
  }

  .profile-card__kicker {
    margin: 0;
    font-size: 0.72rem;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .profile-card__title {
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    color: var(--color-text-heading);
    margin-bottom: var(--space-sm);
  }

  .profile-card__desc {
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.7;
  }

  .section-actions {
    margin-top: var(--space-2xl);
  }

  .hero__bg-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgba(87, 166, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(34, 211, 238, 0.03) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(
      ellipse 80% 80% at 50% 50%,
      black 40%,
      transparent 100%
    );
  }

  /* ── Strengths ── */
  .strength-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .strength-card:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--glow-accent);
  }

  .strength-card__icon {
    display: block;
    font-size: 1.5rem;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
    line-height: 1;
  }

  .strength-card__title {
    font-size: var(--font-size-card-title);
    margin-bottom: var(--space-sm);
    color: var(--color-text-heading);
  }

  .strength-card__desc {
    font-size: var(--font-size-body-sm);
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
  }

  /* ── Project Focus ── */
  .project-focus-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .project-focus-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .project-focus-card__index {
    display: block;
    margin-bottom: var(--space-md);
    color: var(--color-accent);
    font-size: var(--font-size-label);
    letter-spacing: 0.08em;
  }

  .project-focus-card h3 {
    margin-bottom: var(--space-sm);
    color: var(--color-text-heading);
    font-size: var(--font-size-card-title);
  }

  .project-focus-card p {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.65;
    font-size: var(--font-size-body-sm);
  }

  .project-focus-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-2xl);
  }

  /* ── Principles ── */
  .principles-list {
    list-style: none;
    display: grid;
    gap: var(--space-md);
    max-width: var(--container-md);
  }

  .principle {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: start;
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .principle__num {
    color: var(--color-accent);
    font-size: 0.9rem;
    letter-spacing: 0.12em;
  }

  .principle__text {
    color: var(--color-text);
    line-height: 1.7;
    margin: 0;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
  }

  .strengths-list {
    display: grid;
    gap: var(--space-sm);
  }

  .strength-row {
    display: grid;
    grid-template-columns: minmax(5.5rem, auto) auto minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: start;
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .strength-row:first-child {
    border-top-color: var(--color-border-strong);
  }

  .strength-row__mode {
    color: var(--color-accent);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .strength-row__icon {
    color: var(--color-text-dim);
    font-size: 1rem;
    line-height: 1.4;
  }

  .strength-row__title {
    margin-bottom: var(--space-sm);
    color: var(--color-text-heading);
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
  }

  .strength-row__desc {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(260px, 0.9fr);
    gap: var(--space-2xl);
    align-items: start;
  }

  .intro__text h2 {
    margin-bottom: var(--space-lg);
  }

  .intro__text p {
    color: var(--color-text-muted);
    line-height: 1.75;
  }
  .intro__action {
    margin-top: var(--space-md);
  }

  .intro__stats {
    display: grid;
    gap: var(--space-sm);
  }

  .stat-card {
    border-left: 1px solid var(--color-border-strong);
    padding: var(--space-sm) 0 var(--space-sm) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .stat-card__value {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-accent);
