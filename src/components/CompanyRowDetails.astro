---
import type { CareerAtlasCompanyNode } from "../data/projects";
import ExpandableDetailPanel from "./ExpandableDetailPanel.astro";
import CompanyRowProjects from "./CompanyRowProjects.astro";
import { renderRichText } from "../utils/richText";

interface Props {
  company: CareerAtlasCompanyNode;
  safeCompanyColor: string;
}

const { company, safeCompanyColor } = Astro.props;
---

<ExpandableDetailPanel
  id={`${company.id}-panel`}
  title={`${company.organization} details`}
>
  <div
    class="company-row__rich-text"
    set:html={renderRichText(company.longSummary || company.summary)}
  />
  {
    company.roles.length > 0 && (
      <p>
        <span class="text-accent">Roles:</span> {company.roles.join(" / ")}
      </p>
    )
  }
  {
    company.myTimeInfo && (
      <div
        class="company-row__rich-text company-row__rich-text--compact"
        set:html={renderRichText(company.myTimeInfo)}
      />
    )
  }
  {
    company.achievements.length > 0 && (
      <div>
        <p>
          <span class="text-accent">Achievements:</span>
        </p>
        <ul class="company-row__achievements">
          {company.achievements.map((achievement) => (
            <li>{achievement}</li>
          ))}
        </ul>
      </div>
    )
  }
  <p><span class="text-accent">Projects:</span> {company.projectCount}</p>
</ExpandableDetailPanel>

<CompanyRowProjects
  organization={company.organization}
  projects={company.projects}
  safeCompanyColor={safeCompanyColor}
/>

<style>
  .company-row__rich-text {
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .company-row__rich-text > :first-child {
    margin-top: 0;
  }

  .company-row__rich-text > :last-child {
    margin-bottom: 0;
  }

  .company-row__rich-text :global(p) {
    margin: 0 0 var(--space-sm);
  }

  .company-row__rich-text :global(ul),
  .company-row__rich-text :global(ol) {
    margin: 0 0 var(--space-sm);
    padding-left: 1.25rem;
  }

  .company-row__rich-text :global(li) {
    margin-bottom: 0.35rem;
  }

  .company-row__rich-text :global(strong) {
    color: var(--color-text);
  }

  .company-row__achievements {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .company-row__achievements li + li {
    margin-top: var(--space-xs);
  }
</style>
