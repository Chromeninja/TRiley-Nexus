---
import type { CareerAtlasCompanyNode } from "../data/projects";
import CompanyRowDetails from "./CompanyRowDetails.astro";

interface Props {
  company: CareerAtlasCompanyNode;
  safeCompanyColor: string;
}

const { company, safeCompanyColor } = Astro.props;
const hasLongBarLabel = company.organization.length > 28;
---

<div class="company-row__canvas">
  <div class="company-row__track" aria-hidden="true">
    <button
      type="button"
      class="company-row__bar"
      data-company-toggle
      data-company-id={company.id}
      data-long-name={hasLongBarLabel ? "true" : "false"}
      aria-controls={`${company.id}-panel`}
      aria-expanded="false"
      style={`left: ${company.offsetPct}%; width: ${company.widthPct}%;`}
    >
      <span class="company-row__bar-label" title={company.organization}
        >{company.organization}</span
      >
      {
        hasLongBarLabel && (
          <span class="company-row__bar-overflow-cue" aria-hidden="true">
            ...
          </span>
        )
      }
      {
        company.isActive && (
          <span class="company-row__bar-live text-mono">Present</span>
        )
      }
      <span class="company-row__preview" aria-hidden="true">
        <strong>{company.organization}</strong>
        <span>{company.rangeLabel} • {company.projectCount} projects</span>
        <span>{company.longSummary || company.summary}</span>
      </span>
    </button>
  </div>

  <CompanyRowDetails company={company} safeCompanyColor={safeCompanyColor} />
</div>

<style>
  .company-row__canvas {
    position: relative;
  }

  .company-row__track {
    position: relative;
    height: 1.55rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-border), white 3%);
    background:
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 0 72px,
        rgba(255, 255, 255, 0.04) 72px 73px
      ),
      color-mix(in srgb, var(--color-bg-card), black 14%);
    overflow: visible;
  }

  .company-row__bar {
    position: absolute;
    top: 2px;
    bottom: 2px;
    z-index: 2;
    min-width: 10px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--company-color), black 15%);
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--company-color), black 22%),
      color-mix(in srgb, var(--company-color), white 12%)
    );
    color: color-mix(in srgb, var(--company-color), white 82%);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      box-shadow var(--transition-base),
      transform var(--transition-fast),
      max-width var(--transition-fast);
    overflow: hidden;
    white-space: nowrap;
    text-shadow: 0 0 8px color-mix(in srgb, var(--company-color), black 45%);
  }

  .company-row__bar-label {
    display: block;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #050505;
    font-weight: 800;
    text-shadow: none;
  }

  .company-row__bar-overflow-cue {
    flex: 0 0 auto;
    font-size: 0.6rem;
    letter-spacing: 0.02em;
    color: #050505;
    opacity: 0.88;
  }

  .company-row__bar[data-long-name="true"]:hover .company-row__bar-overflow-cue,
  .company-row__bar[data-long-name="true"]:focus-visible
    .company-row__bar-overflow-cue {
    display: none;
  }

  .company-row__bar[data-long-name="true"]:hover,
  .company-row__bar[data-long-name="true"]:focus-visible {
    width: max-content !important;
    max-width: min(34rem, 78vw);
    overflow: visible;
    z-index: 12;
  }

  .company-row__bar[data-long-name="true"]:hover .company-row__bar-label,
  .company-row__bar[data-long-name="true"]:focus-visible
    .company-row__bar-label {
    overflow: visible;
    text-overflow: clip;
  }

  .company-row__bar-live {
    flex: 0 0 auto;
    color: color-mix(in srgb, var(--color-success), white 16%);
    text-shadow: 0 0 10px rgba(74, 222, 128, 0.4);
    font-size: 0.54rem;
    font-weight: 700;
  }

  .company-row__bar:focus-visible {
    outline: 2px solid white;
    outline-offset: 2px;
  }

  .company-row__bar:hover,
  .company-row[data-expanded="true"] .company-row__bar {
    box-shadow: 0 0 20px
      color-mix(in srgb, var(--company-color), transparent 55%);
    transform: translateY(-1px);
    filter: saturate(1.12) brightness(1.04);
  }

  .company-row__preview {
    pointer-events: none;
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.55rem);
    z-index: 14;
    width: min(30rem, 56vw);
    min-width: 16rem;
    border: 1px solid color-mix(in srgb, var(--company-color), transparent 40%);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-bg), black 14%);
    box-shadow: var(--shadow-card);
    color: var(--color-text);
    display: grid;
    gap: 0.3rem;
    padding: 0.5rem 0.65rem;
    opacity: 0;
    transform: translate(-50%, 4px);
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast),
      filter var(--transition-fast);
    filter: saturate(0.95);
  }

  .company-row__preview strong {
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: color-mix(in srgb, var(--company-color), white 65%);
  }

  .company-row__preview span {
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--color-text-muted);
    text-transform: none;
    letter-spacing: normal;
    font-weight: 500;
  }

  .company-row__bar:hover .company-row__preview,
  .company-row__bar:focus-visible .company-row__preview {
    opacity: 1;
    transform: translate(-50%, 0);
    filter: saturate(1);
  }

  @media (max-width: 640px) {
    .company-row__track {
      height: auto;
      background: transparent;
      border: 0;
    }

    .company-row__bar {
      position: relative;
      width: 100% !important;
      left: 0 !important;
      min-height: 2.1rem;
    }

    .company-row__preview {
      display: none;
    }
  }
</style>
