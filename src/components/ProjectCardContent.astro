---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  projectDateRange?: string;
  summaryText: string;
  cardHighlights: string[];
  cardCtaLabel: string;
}

const { project, projectDateRange, summaryText, cardHighlights, cardCtaLabel } = Astro.props;
---

<h3 class="project-card__title">{project.title}</h3>

{
  (project.roleTitle || projectDateRange) && (
    <p class="project-card__meta-line text-mono text-muted">
      {project.roleTitle && (
        <span class="project-card__role">{project.roleTitle}</span>
      )}
      {project.roleTitle && projectDateRange && (
        <span class="project-card__meta-divider" aria-hidden="true">
          •
        </span>
      )}
      {projectDateRange && (
        <span class="project-card__timeframe">{projectDateRange}</span>
      )}
    </p>
  )
}

<p class="project-card__summary">{summaryText}</p>

{
  cardHighlights.length > 0 && (
    <ul
      class="project-card__highlights"
      aria-label={`${project.title} highlights`}
    >
      {cardHighlights.map((highlight) => (
        <li>{highlight}</li>
      ))}
    </ul>
  )
}

<span class="project-card__writeup-cue text-mono">{cardCtaLabel}</span>
<div class="project-card__tags">
  {project.tags.slice(0, 4).map((tag) => <span>{tag}</span>)}
  {project.tags.length > 4 && <span>+{project.tags.length - 4}</span>}
</div>

<style>
  .project-card__title {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-text-heading);
    line-height: 1.3;
    margin: 0;
    position: relative;
    z-index: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-card__meta-line {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-width: 0;
    font-size: 0.74rem;
    letter-spacing: 0.05em;
    margin: 0;
    position: relative;
    z-index: 1;
    white-space: nowrap;
  }

  .project-card__timeframe {
    flex: 0 0 auto;
    font-size: 0.74rem;
    margin: 0;
  }

  .project-card__role {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.74rem;
    margin: 0;
  }

  .project-card__meta-divider {
    flex: 0 0 auto;
    opacity: 0.65;
    line-height: 1;
  }

  .project-card__summary {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
    position: relative;
    z-index: 1;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.project-card--featured) .project-card__summary {
    font-size: 0.94rem;
    line-height: 1.65;
    -webkit-line-clamp: 3;
  }

  .project-card__highlights {
    margin: 0;
    padding-left: 1rem;
    display: grid;
    gap: var(--space-sm);
    color: var(--color-text-muted);
    font-size: 0.82rem;
    line-height: 1.5;
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-md);
  }

  .project-card__highlights li {
    margin: 0;
  }

  .project-card__writeup-cue {
    width: fit-content;
    color: var(--color-text-dim);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: auto;
    position: relative;
    z-index: 1;
    color: var(--color-text-dim);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .project-card__tags span + span::before {
    content: "/";
    margin-inline-end: var(--space-xs);
    color: var(--color-border-strong);
  }

  @media (max-width: 640px) {
    .project-card__title {
      font-size: 1rem;
      line-height: 1.35;
    }

    .project-card__meta-line {
      white-space: normal;
      flex-wrap: wrap;
      row-gap: 0.2rem;
    }

    .project-card__role {
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
      flex-basis: 100%;
    }

    .project-card__meta-divider {
      display: none;
    }

    .project-card__summary {
      font-size: 0.9rem;
      line-height: 1.55;
      -webkit-line-clamp: 2;
    }

    .project-card__highlights {
      font-size: 0.82rem;
      gap: var(--space-xs);
    }
  }
</style>
