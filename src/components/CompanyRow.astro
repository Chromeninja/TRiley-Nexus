---
import type { CareerAtlasCompanyNode } from "../data/projects";
import CompanyRowMeta from "./CompanyRowMeta.astro";
import CompanyRowBar from "./CompanyRowBar.astro";
import { sanitizeCssColor } from "../utils/sanitizeCssColor";

interface Props {
  company: CareerAtlasCompanyNode;
}

const { company } = Astro.props;
const safeCompanyColor = sanitizeCssColor(company.color);
---

<article
  id={company.id}
  class="company-row"
  data-company-row
  data-expanded="false"
  style={`--company-color: ${safeCompanyColor};`}
>
  <CompanyRowMeta company={company} />

  <CompanyRowBar company={company} safeCompanyColor={safeCompanyColor} />
</article>

<style>
  .company-row {
    display: grid;
    grid-template-columns: minmax(10rem, var(--atlas-meta-col)) minmax(
        var(--atlas-canvas-min),
        1fr
      );
    gap: var(--atlas-grid-gap);
    align-items: start;
    border-top: 1px solid color-mix(in srgb, var(--color-border), white 5%);
    padding-top: var(--space-md);
    margin-top: var(--space-md);
  }

  :global(.career-atlas[data-view="overview"]) .company-row {
    grid-template-columns: 1fr;
    gap: 0;
    padding-top: 0.55rem;
    margin-top: 0.55rem;
  }

  :global(.career-atlas[data-view="overview"]) .company-row:first-child {
    margin-top: 0.2rem;
  }

  @media (max-width: 640px) {
    .company-row {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
      padding-top: var(--space-lg);
    }
  }
</style>
