---
// SectionHeader.astro: Reusable section heading block
interface Props {
  label?: string;
  title: string;
  subtitle?: string;
  centered?: boolean;
}

const { label, title, subtitle, centered = false } = Astro.props;
---

<div class={`section-header ${centered ? "section-header--centered" : ""}`}>
  {label && <p class="section-label">{label}</p>}
  <h2>{title}</h2>
  {subtitle && <p class="section-header__subtitle">{subtitle}</p>}
</div>

<style>
  .section-header {
    margin-bottom: var(--space-2xl);
    position: relative;
  }

  .section-header h2 {
    max-width: 16ch;
    margin: 0;
  }

  .section-header--centered {
    text-align: center;
  }

  .section-header--centered h2 {
    margin-inline: auto;
  }

  .section-header__subtitle {
    margin-top: var(--space-md);
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    max-width: 60ch;
    line-height: 1.7;
  }

  .section-header--centered .section-header__subtitle {
    margin-inline: auto;
  }

  @media (max-width: 640px) {
    .section-header {
      margin-bottom: var(--space-xl);
    }

    .section-header__subtitle {
      font-size: 0.96rem;
      line-height: 1.65;
    }
  }
</style>
