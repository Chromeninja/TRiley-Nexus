---
import GalleryControls from "./GalleryControls.astro";
import GalleryImageViewer from "./GalleryImageViewer.astro";
import type { Project } from "../data/projects";

interface Props {
  media?: Project["media"];
}

const { media = [] } = Astro.props;

const firstCoverIndex = media.findIndex((item) => item.isCover === true);
const orderedMedia =
  firstCoverIndex <= 0
    ? media
    : [
        media[firstCoverIndex],
        ...media.slice(0, firstCoverIndex),
        ...media.slice(firstCoverIndex + 1),
      ];
---

{
  orderedMedia.length > 0 && (
    <section
      class="project-gallery"
      data-project-gallery
      aria-roledescription="carousel"
      aria-label="Project media gallery"
    >
      <GalleryImageViewer orderedMedia={orderedMedia} />
      <GalleryControls count={orderedMedia.length} />
    </section>
  )
}

<script>
  import { initProjectGalleryInteractions } from "../utils/projectGalleryInteractions";

  initProjectGalleryInteractions();
</script>

<style is:global>
  .project-gallery {
    margin-bottom: var(--space-2xl);
    display: grid;
    gap: var(--space-md);
    position: relative;
  }

  .project-gallery__viewport {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-card);
    box-shadow: var(--shadow-card);
    scrollbar-width: none;
    -ms-overflow-style: none;
    touch-action: pan-x pan-y pinch-zoom;
    overscroll-behavior-x: contain;
  }

  .project-gallery__viewport::-webkit-scrollbar {
    display: none;
  }

  .project-gallery__slide {
    margin: 0;
    min-width: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .project-gallery__slide.is-active {
    outline: none;
  }

  .project-gallery__media {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    background: var(--color-bg);
    display: block;
  }

  .project-gallery__controls {
    display: grid;
    gap: var(--space-sm);
  }

  .project-gallery__toolbar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
  }

  .project-gallery__nav {
    width: 36px;
    height: 36px;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast),
      background var(--transition-fast);
  }

  .project-gallery__nav:hover,
  .project-gallery__nav:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-accent-dim);
    outline: none;
  }

  .project-gallery__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
  }

  .project-gallery__dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    border: 1px solid var(--color-border-strong);
    background: transparent;
    cursor: pointer;
    transition:
      transform var(--transition-fast),
      background var(--transition-fast),
      border-color var(--transition-fast);
  }

  .project-gallery__dot:hover,
  .project-gallery__dot:focus-visible {
    border-color: var(--color-accent);
    background: var(--color-accent-dim);
    outline: none;
  }

  .project-gallery__dot.is-active {
    border-color: var(--color-accent);
    background: var(--color-accent);
    transform: scale(1.15);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .project-gallery__toolbar {
      gap: var(--space-sm);
    }

    .project-gallery__nav {
      width: 32px;
      height: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-gallery__viewport {
      scroll-behavior: auto;
    }
  }
</style>
