---
import {
  sortProjectsByOrderThenRecency,
  type Project,
} from "../data/projects";
import { type TimelineYearGroup } from "../data/careerTimeline";
import CareerScrollTimelineRail from "./CareerScrollTimelineRail.astro";
import CareerScrollTimelineCard from "./CareerScrollTimelineCard.astro";
import CareerScrollTimelineMonth from "./CareerScrollTimelineMonth.astro";

interface Props {
  currentProjects: Project[];
  yearGroups: TimelineYearGroup[];
}

const { currentProjects, yearGroups } = Astro.props;
const referenceNow = new Date();

const sortedCurrentProjects = [...currentProjects].sort((a, b) =>
  sortProjectsByOrderThenRecency(a, b, referenceNow),
);
---

<div class="career-scroll" data-career-scroll>
  <div class="career-scroll__layout">
    <CareerScrollTimelineRail {yearGroups} />

    <div class="career-scroll__content">
      <section
        id="career-present"
        class="career-scroll__section panel"
        data-observe-year
      >
        <header class="career-scroll__section-head">
          <p class="text-mono career-scroll__section-label">NOW</p>
          <h2>Current Projects</h2>
          <p>
            Current role and projects are pinned first. Continue scrolling to
            move backward in time.
          </p>
        </header>

        {
          sortedCurrentProjects.length === 0 ? (
            <p class="career-scroll__empty">
              No active projects are currently tagged.
            </p>
          ) : (
            <ul class="career-scroll__cards" role="list">
              {sortedCurrentProjects.map((project) => (
                <CareerScrollTimelineCard project={project} isCurrent={true} />
              ))}
            </ul>
          )
        }
      </section>

      {
        yearGroups.map((yearGroup) => (
          <section
            id={yearGroup.key}
            class="career-scroll__section panel"
            data-observe-year
          >
            <header class="career-scroll__section-head">
              <p class="text-mono career-scroll__section-label">
                {yearGroup.year}
              </p>
              <h2>{yearGroup.year}</h2>
              <p>
                {yearGroup.months.reduce(
                  (sum, month) => sum + month.projects.length,
                  0,
                )}{" "}
                project entries
              </p>
            </header>

            <div class="career-scroll__months">
              {yearGroup.months.map((monthGroup) => (
                <CareerScrollTimelineMonth monthGroup={monthGroup} />
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</div>

<script>
  const root = document.querySelector("[data-career-scroll]");

  if (root) {
    const jumpButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-link-target]"),
    );

    const clearType = (type: string) => {
      jumpButtons
        .filter((button) => button.dataset.linkType === type)
        .forEach((button) => button.classList.remove("is-active"));
    };

    const activateForType = (type: string, targetId: string) => {
      clearType(type);
      jumpButtons
        .filter(
          (button) =>
            button.dataset.linkType === type &&
            button.dataset.linkTarget === targetId,
        )
        .forEach((button) => button.classList.add("is-active"));
    };

    jumpButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const targetId = button.dataset.linkTarget;
        if (!targetId) {
          return;
        }

        const target = document.getElementById(targetId);
        if (!target) {
          return;
        }

        target.scrollIntoView({ behavior: "smooth", block: "start" });
        const type = button.dataset.linkType;
        if (type) {
          activateForType(type, targetId);
        }
      });
    });

    const yearObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) {
            continue;
          }
          activateForType("year", entry.target.id);
        }
      },
      {
        rootMargin: "-35% 0px -45% 0px",
        threshold: 0.1,
      },
    );

    const monthObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) {
            continue;
          }
          activateForType("month", entry.target.id);
        }
      },
      {
        rootMargin: "-40% 0px -45% 0px",
        threshold: 0.1,
      },
    );

    const projectObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) {
            continue;
          }
          activateForType("project", entry.target.id);
        }
      },
      {
        rootMargin: "-45% 0px -40% 0px",
        threshold: 0.1,
      },
    );

    root
      .querySelectorAll("[data-observe-year]")
      .forEach((el) => yearObserver.observe(el));
    root
      .querySelectorAll("[data-observe-month]")
      .forEach((el) => monthObserver.observe(el));
    root
      .querySelectorAll("[data-observe-project]")
      .forEach((el) => projectObserver.observe(el));

    activateForType("year", "career-present");
  }
</script>

<style>
  .career-scroll__layout {
    display: grid;
    grid-template-columns: minmax(250px, 320px) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .career-scroll__content {
    display: grid;
    gap: var(--space-lg);
  }

  .career-scroll__section {
    scroll-margin-top: calc(var(--nav-height) + var(--space-md));
  }

  .career-scroll__section-head h2 {
    margin: 0;
  }

  .career-scroll__section-head p {
    margin: var(--space-xs) 0 0;
    color: var(--color-text-muted);
  }

  .career-scroll__section-label {
    margin: 0;
    color: var(--color-text-dim);
    font-size: 0.74rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .career-scroll__months {
    margin-top: var(--space-lg);
    display: grid;
    gap: var(--space-lg);
  }

  .career-scroll__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
  }

  .career-scroll__empty {
    margin-top: var(--space-md);
  }

  @media (max-width: 980px) {
    .career-scroll__layout {
      grid-template-columns: 1fr;
    }
  }
</style>
