---
// SkillAtlasRadar.astro: dependency-free SVG radar chart for skill atlas.
// Server-rendered. Interactive enhancements provided by skillAtlasInteractions.ts
// (progressive enhancement — full polygon + table fallback render without JS).
import type { SkillAtlasData } from "../data/skillAtlas";

interface Props {
  data: SkillAtlasData;
  size?: number;
}

const { data, size = 520 } = Astro.props;

const axes = data.axes;
const axisCount = axes.length;
const center = size / 2;
const padding = Math.round(size * 0.18);
const radius = center - padding;
const ringCount = 4;

function polarToXY(value: number, angleRad: number): { x: number; y: number } {
  const r = (Math.max(0, Math.min(100, value)) / 100) * radius;
  return {
    x: center + r * Math.cos(angleRad),
    y: center + r * Math.sin(angleRad),
  };
}

const angles = axes.map(
  (_, index) => -Math.PI / 2 + (index * 2 * Math.PI) / Math.max(1, axisCount),
);

const ringPaths = Array.from({ length: ringCount }, (_, i) => {
  const ringValue = ((i + 1) / ringCount) * 100;
  return (
    angles
      .map((angle, index) => {
        const pt = polarToXY(ringValue, angle);
        return `${index === 0 ? "M" : "L"} ${pt.x.toFixed(2)} ${pt.y.toFixed(2)}`;
      })
      .join(" ") + " Z"
  );
});

const dataPolygonPoints = axes
  .map((axis, index) => {
    const pt = polarToXY(Math.max(axis.normalizedScore, 4), angles[index]);
    return `${pt.x.toFixed(2)},${pt.y.toFixed(2)}`;
  })
  .join(" ");

const axisLabels = axes.map((axis, index) => {
  const angle = angles[index];
  // Place labels well outside the outermost ring so they never collide with data
  const labelRadius = radius + Math.round(size * 0.09);
  const x = center + labelRadius * Math.cos(angle);
  const y = center + labelRadius * Math.sin(angle);
  return {
    x,
    y,
    icon: axis.icon,
    score: axis.normalizedScore,
    group: axis.group,
    index,
  };
});

const dataPointPositions = axes.map((axis, index) => {
  const pt = polarToXY(Math.max(axis.normalizedScore, 4), angles[index]);
  return { ...pt, axis, index };
});
---

<div class="skill-radar" data-skill-radar>
  <figure
    class="skill-radar__chart"
    role="img"
    aria-label={`Radar chart of skill group strength across ${axisCount} groups`}
  >
    <svg
      viewBox={`0 0 ${size} ${size}`}
      preserveAspectRatio="xMidYMid meet"
      class="skill-radar__svg"
      aria-hidden="false"
    >
      <title>Skill Atlas Radar</title>
      <desc>
        Radar chart showing relative strength of each skill group, weighted by
        contributing projects across status, recency, and featured emphasis.
      </desc>
      <g class="skill-radar__rings" aria-hidden="true">
        {ringPaths.map((d) => <path d={d} class="skill-radar__ring" />)}
      </g>
      <g class="skill-radar__axes" aria-hidden="true">
        {
          angles.map((angle) => {
            const end = polarToXY(100, angle);
            return (
              <line
                x1={center}
                y1={center}
                x2={end.x.toFixed(2)}
                y2={end.y.toFixed(2)}
                class="skill-radar__axis-line"
              />
            );
          })
        }
      </g>
      <polygon
        class="skill-radar__data"
        points={dataPolygonPoints}
        data-skill-radar-polygon></polygon>
      {
        dataPointPositions.map((pt) => (
          <circle
            cx={pt.x.toFixed(2)}
            cy={pt.y.toFixed(2)}
            r="6"
            class="skill-radar__point"
            data-skill-radar-point
            data-axis-index={pt.index}
          >
            <title>{`${pt.axis.group}: ${pt.axis.normalizedScore}/100`}</title>
          </circle>
        ))
      }
      {
        axisLabels.map((label) => (
          <text
            x={label.x.toFixed(2)}
            y={label.y.toFixed(2)}
            text-anchor="middle"
            class="skill-radar__label"
            data-axis-label
            data-axis-index={label.index}
            aria-label={`${label.group}: ${label.score}/100`}
          >
            <tspan
              class="skill-radar__label-icon"
              x={label.x.toFixed(2)}
              dy="-0.5em"
            >{label.icon}</tspan>
            <tspan
              class="skill-radar__label-score"
              x={label.x.toFixed(2)}
              dy="1.4em"
            >{label.score}</tspan>
          </text>
        ))
      }
    </svg>
  </figure>
  <div
    class="skill-radar__controls"
    role="tablist"
    aria-label="Skill group axes"
  >
    {
      axes.map((axis, index) => (
        <button
          type="button"
          class="skill-radar__control"
          data-axis-control
          data-axis-index={index}
          aria-controls={`axis-${index}-panel`}
          aria-pressed={index === 0 ? "true" : "false"}
          role="tab"
        >
          <span class="skill-radar__control-icon" aria-hidden="true">
            {axis.icon}
          </span>
          <span class="skill-radar__control-label">{axis.group}</span>
          <span class="skill-radar__control-score text-mono">
            {axis.normalizedScore}
            <span class="skill-radar__control-max">/100</span>
          </span>
        </button>
      ))
    }
  </div>
  <noscript>
    <table class="skill-radar__fallback">
      <caption>Skill group strength (text fallback)</caption>
      <thead>
        <tr><th>Group</th><th>Score</th><th>Projects</th></tr>
      </thead>
      <tbody>
        {
          axes.map((axis) => (
            <tr>
              <td>{axis.group}</td>
              <td>{axis.normalizedScore}/100</td>
              <td>{axis.projectCount}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </noscript>
</div>

<style>
  .skill-radar {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: center;
  }

  .skill-radar__chart {
    margin: 0;
  }

  .skill-radar__svg {
    width: 100%;
    height: auto;
    max-width: 560px;
    display: block;
    margin-inline: auto;
  }

  .skill-radar__ring {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 1;
    opacity: 0.6;
  }

  .skill-radar__axis-line {
    stroke: var(--color-border);
    stroke-width: 1;
    opacity: 0.5;
  }

  .skill-radar__data {
    fill: var(--color-accent-dim);
    stroke: var(--color-accent);
    stroke-width: 2;
    transition: fill 200ms ease;
  }

  .skill-radar__point {
    fill: var(--color-accent);
    stroke: var(--color-bg-secondary);
    stroke-width: 2;
    cursor: pointer;
    transition:
      r 150ms ease,
      fill 150ms ease;
  }

  .skill-radar__point[data-active="true"] {
    fill: var(--color-accent2);
    r: 9;
  }

  .skill-radar__label {
    font-family: var(--font-mono);
    fill: var(--color-text-muted);
  }

  .skill-radar__label[data-active="true"] {
    fill: var(--color-accent);
  }

  .skill-radar__label-icon {
    fill: var(--color-accent);
    font-size: 1rem;
  }

  .skill-radar__label[data-active="true"] .skill-radar__label-icon {
    fill: var(--color-accent2);
  }

  .skill-radar__label-score {
    font-size: 0.7rem;
  }

  .skill-radar__controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .skill-radar__control {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background 150ms ease,
      border-color 150ms ease,
      transform 150ms ease;
  }

  .skill-radar__control:hover,
  .skill-radar__control:focus-visible {
    border-color: var(--color-accent);
    background: var(--color-accent-dim);
    outline: none;
  }

  .skill-radar__control[aria-pressed="true"] {
    border-color: var(--color-accent);
    background: var(--color-accent-dim);
    box-shadow: 0 0 0 1px var(--color-accent-glow);
  }

  .skill-radar__control-icon {
    color: var(--color-accent);
    font-size: 1.125rem;
    line-height: 1;
  }

  .skill-radar__control-label {
    font-size: var(--font-size-body-sm);
    min-width: 0;
    overflow-wrap: anywhere;
    line-height: 1.3;
  }

  .skill-radar__control-score {
    color: var(--color-accent);
    font-size: var(--font-size-meta);
    white-space: nowrap;
  }

  .skill-radar__control-max {
    color: var(--color-text-muted);
    margin-left: 2px;
  }

  .skill-radar__fallback {
    width: 100%;
    margin-top: var(--space-lg);
    border-collapse: collapse;
  }

  .skill-radar__fallback th,
  .skill-radar__fallback td {
    border: 1px solid var(--color-border);
    padding: var(--space-xs) var(--space-sm);
    text-align: left;
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-radar__data,
    .skill-radar__point,
    .skill-radar__control {
      transition: none;
    }
  }

  @media (max-width: 860px) {
    .skill-radar {
      grid-template-columns: 1fr;
    }

    .skill-radar__controls {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  }

  @media (max-width: 640px) {
    .skill-radar__control {
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--space-sm);
    }

    .skill-radar__control-score {
      grid-column: 2;
    }
  }
</style>
