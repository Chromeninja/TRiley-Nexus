---
import ExpandableDetailPanel from "./ExpandableDetailPanel.astro";
import CareerNarrativeCompanyHeader from "./CareerNarrativeCompanyHeader.astro";
import CareerNarrativeCompanyPanel from "./CareerNarrativeCompanyPanel.astro";
import CareerNarrativeProjectRow from "./CareerNarrativeProjectRow.astro";
import { type CareerNarrativeCompanyNode } from "../data/projects";
import { sanitizeCssColor } from "../utils/sanitizeCssColor";

interface Props {
  company: CareerNarrativeCompanyNode;
  companyIndex: number;
}

const { company, companyIndex } = Astro.props;
---

<article
  id={company.id}
  class="narrative-company"
  data-narrative-company
  data-company-id={company.id}
  data-expanded="false"
  style={`--company-color: ${sanitizeCssColor(company.color)};`}
>
  <div class="narrative-company__node" aria-hidden="true">
    <span class="narrative-company__node-index text-mono">
      {String(companyIndex + 1).padStart(2, "0")}
    </span>
    <span class="narrative-company__node-dot"></span>
  </div>

  <CareerNarrativeCompanyHeader company={company} />

  <ExpandableDetailPanel
    id={`${company.id}-panel`}
    title={`${company.organization} details`}
  >
    <CareerNarrativeCompanyPanel company={company} />

    <div
      class="narrative-projects"
      aria-label={`${company.organization} projects`}
    >
      <CareerNarrativeProjectRow projects={company.projects} />
    </div>
  </ExpandableDetailPanel>
</article>

<style>
  .narrative-company {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--space-md);
  }

  .narrative-company--hidden {
    display: none;
  }

  .narrative-company__node {
    display: grid;
    justify-items: center;
    gap: 0.55rem;
    padding-top: 1.15rem;
  }

  .narrative-company__node-index {
    font-size: 0.66rem;
    color: var(--color-text-dim);
    letter-spacing: 0.08em;
  }

  .narrative-company__node-dot {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--company-color), white 30%);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--company-color), white 8%),
      color-mix(in srgb, var(--company-color), black 24%)
    );
    box-shadow: 0 0 0 0.35rem
      color-mix(in srgb, var(--company-color), transparent 86%);
  }

  /* :global() required: .expandable-detail is rendered by
     ExpandableDetailPanel.astro, so it never gets this component's scope. */
  .narrative-company > :global(.expandable-detail) {
    grid-column: 2 / -1;
  }

  .narrative-projects {
    display: grid;
    gap: 0.8rem;
  }

  @media (max-width: 720px) {
    .narrative-company {
      grid-template-columns: 1.5rem minmax(0, 1fr);
    }
  }

  @media (max-width: 540px) {
    .narrative-company__node-index {
      display: none;
    }

    .narrative-company {
      grid-template-columns: 1fr;
    }

    .narrative-company > :global(.expandable-detail) {
      grid-column: 1 / -1;
    }

    .narrative-company__node {
      display: none;
    }
  }
</style>
