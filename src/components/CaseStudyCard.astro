---
// CaseStudyCard.astro: Featured project preview with case-study structure
import {
  formatProjectDateRange,
  projectStatusColors,
  projectStatusLabels,
  type Project,
} from "../data/projects";
import {
  normalizeWhitespace,
  resolveMediaPath,
  toBasePath,
} from "../utils/paths";
import { richTextToPlainText } from "../utils/richText";

interface Props {
  project: Project;
  rank: number;
}

const { project, rank } = Astro.props;
const projectPath = toBasePath(`/projects/${project.slug}`);
const projectDateRange = formatProjectDateRange(project);

function firstSentence(value?: string): string | undefined {
  const normalized = normalizeWhitespace(richTextToPlainText(value));
  if (!normalized) {
    return undefined;
  }

  const match = normalized.match(/^(.+?[.!?])(?:\s|$)/);
  return (match ? match[1] : normalized).trim();
}

const coverMediaItem = project.media?.find(
  (
    item,
  ): item is Extract<
    NonNullable<Project["media"]>[number],
    { type: "image" }
  > => item.type === "image" && item.isCover === true,
);
const firstVideo = project.media?.find((item) => item.type === "video");
const firstImage = project.media?.find(
  (
    item,
  ): item is Extract<
    NonNullable<Project["media"]>[number],
    { type: "image" }
  > => item.type === "image",
);
const coverMedia = coverMediaItem
  ? {
      src: resolveMediaPath(coverMediaItem.src),
      alt: coverMediaItem.alt,
    }
  : project.cover
    ? {
        src: resolveMediaPath(project.cover.src),
        alt: project.cover.alt,
      }
    : firstVideo?.poster
      ? {
          src: resolveMediaPath(firstVideo.poster),
          alt: `${project.title} video preview`,
        }
      : firstImage
        ? {
            src: resolveMediaPath(firstImage.src),
            alt: firstImage.alt,
          }
        : undefined;

const summaryText = (project.cardSummary ?? project.summary).trim();
const problemPreview = firstSentence(project.problem);
const outcomePreview = firstSentence(project.outcome);
const proofItems = (
  project.highlights
    ?.map((item) => normalizeWhitespace(item))
    .filter(Boolean) ??
  [problemPreview, outcomePreview].filter((item): item is string =>
    Boolean(item),
  )
).slice(0, 3);
---

<article class="case-study-card">
  <a
    href={projectPath}
    class={`case-study-card__media ${coverMedia ? "" : "case-study-card__media--empty"}`}
    aria-label={`Read case study: ${project.title}`}
  >
    {
      coverMedia ? (
        <img
          src={coverMedia.src}
          alt={coverMedia.alt}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span class="text-mono">{project.category}</span>
      )
    }
  </a>

  <div class="case-study-card__body">
    <div class="case-study-card__meta">
      <span class={`badge ${projectStatusColors[project.status]}`}>
        {projectStatusLabels[project.status]}
      </span>
      <span class="case-study-card__rank text-mono">
        Case {String(rank).padStart(2, "0")}
      </span>
    </div>

    <p class="case-study-card__context text-mono">
      {project.category}
      {projectDateRange && <span> / {projectDateRange}</span>}
    </p>

    <h3 class="case-study-card__title">
      <a href={projectPath}>{project.title}</a>
    </h3>

    <p class="case-study-card__summary">{summaryText}</p>

    <div
      class="case-study-card__arc"
      aria-label={`${project.title} case-study arc`}
    >
      {
        problemPreview && (
          <div>
            <span class="text-mono">Problem</span>
            <p>{problemPreview}</p>
          </div>
        )
      }
      {
        outcomePreview && (
          <div>
            <span class="text-mono">Outcome</span>
            <p>{outcomePreview}</p>
          </div>
        )
      }
    </div>

    {
      proofItems.length > 0 && (
        <ul
          class="case-study-card__proof"
          aria-label={`${project.title} proof points`}
        >
          {proofItems.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }

    <a href={projectPath} class="case-study-card__action text-mono">
      Read case study
    </a>
  </div>
</article>

<style>
  .case-study-card {
    display: grid;
    grid-template-columns: minmax(18rem, 0.44fr) minmax(0, 1fr);
    gap: var(--space-xl);
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-secondary);
  }

  .case-study-card__media {
    display: block;
    min-height: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg);
    text-decoration: none;
  }

  .case-study-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case-study-card__media--empty {
    display: grid;
    place-items: center;
    color: var(--color-accent);
    background: var(--color-bg-card);
  }

  .case-study-card__body {
    display: grid;
    align-content: start;
    gap: var(--space-md);
  }

  .case-study-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .case-study-card__rank,
  .case-study-card__context {
    margin: 0;
    color: var(--color-text-dim);
    font-size: var(--font-size-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-study-card__title {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
  }

  .case-study-card__title a {
    color: var(--color-text-heading);
    text-decoration: none;
  }

  .case-study-card__title a:hover,
  .case-study-card__title a:focus-visible,
  .case-study-card__action:hover,
  .case-study-card__action:focus-visible {
    color: var(--color-accent);
  }

  .case-study-card__summary {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .case-study-card__arc {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .case-study-card__arc div {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .case-study-card__arc span {
    display: block;
    margin-bottom: var(--space-xs);
    color: var(--color-accent);
    font-size: var(--font-size-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-study-card__arc p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-body-sm);
    line-height: 1.6;
  }

  .case-study-card__proof {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding-left: var(--space-lg);
    color: var(--color-text);
    font-size: var(--font-size-body-sm);
    line-height: 1.55;
  }

  .case-study-card__action {
    width: fit-content;
    color: var(--color-accent);
    font-size: var(--font-size-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 820px) {
    .case-study-card {
      grid-template-columns: 1fr;
    }

    .case-study-card__media {
      min-height: 0;
    }
  }

  @media (max-width: 640px) {
    .case-study-card {
      padding: var(--space-lg);
    }

    .case-study-card__arc {
      grid-template-columns: 1fr;
    }
  }
</style>
