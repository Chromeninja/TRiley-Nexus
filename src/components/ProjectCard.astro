---
// ProjectCard.astro: Reusable project card component
import {
  formatProjectDateRange,
  projectStatusColors,
  projectStatusLabels,
  type Project,
} from "../data/projects";
import { toBasePath, resolveMediaPath, normalizeWhitespace } from "../utils/paths";

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const projectPath = toBasePath(`/projects/${project.slug}`);
const actionLinks = project.links?.slice(0, 2) ?? [];
const projectDateRange = formatProjectDateRange(project);

function firstSentence(value: string): string {
  const normalized = normalizeWhitespace(value);
  const match = normalized.match(/^[^.!?]+[.!?]?/);
  return (match ? match[0] : normalized).trim();
}

const summaryText = (project.cardSummary ?? project.summary).trim();
const fallbackHighlights = [project.problem, project.approach, project.outcome]
  .filter((entry): entry is string => Boolean(entry && entry.trim()))
  .map((entry) => firstSentence(entry));
const cardHighlights = (
  project.highlights?.map((entry) => normalizeWhitespace(entry))?.filter(Boolean) ??
  fallbackHighlights
).slice(0, 3);

const firstVideo = project.media?.find((item) => item.type === "video");
const firstImage = project.media?.find((item) => item.type === "image");
const coverMedia = project.cover
  ? {
      src: resolveMediaPath(project.cover.src),
      alt: project.cover.alt,
    }
  : firstVideo?.poster
    ? {
        src: resolveMediaPath(firstVideo.poster),
        alt: `${project.title} video preview`,
      }
    : firstImage
      ? {
          src: resolveMediaPath(firstImage.src),
          alt: firstImage.alt,
        }
      : undefined;

const previewVideo = firstVideo
  ? {
      src: resolveMediaPath(firstVideo.src),
      poster: firstVideo.poster ? resolveMediaPath(firstVideo.poster) : undefined,
    }
  : undefined;

const hasMedia = Boolean(coverMedia || previewVideo);
const hasHoverPreview = Boolean(project.cover && previewVideo);
---

<article class={`project-card ${featured ? "project-card--featured" : ""}`}>
  <div class="project-card__header">
    <div class="project-card__meta">
      <span class={`badge ${projectStatusColors[project.status]}`}
        >{projectStatusLabels[project.status]}</span
      >
      {
        project.organization &&
          (project.organizationUrl ? (
            <a
              href={project.organizationUrl}
              class="project-card__org text-mono text-muted"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${project.organization} website`}
            >
              {project.organization}
            </a>
          ) : (
            <span class="project-card__org text-mono text-muted">
              {project.organization}
            </span>
          ))
      }
    </div>
    <a
      href={projectPath}
      class="project-card__arrow-link"
      aria-label={`View project: ${project.title}`}
    >
      <span class="project-card__arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <a
    href={projectPath}
    class="project-card__main-link"
    aria-label={`View project: ${project.title}`}
  >
    <div
      class={`project-card__media ${hasHoverPreview ? "project-card__media--hover-preview" : ""} ${hasMedia ? "" : "project-card__media--empty"}`}
      data-project-card-media={hasHoverPreview ? "hover-preview" : undefined}
      aria-hidden={hasMedia ? undefined : "true"}
    >
      {coverMedia && (
        <img
          class={`project-card__media-image ${hasHoverPreview ? "project-card__media-image--cover" : ""}`}
          src={coverMedia.src}
          alt={coverMedia.alt}
          loading="lazy"
          decoding="async"
        />
      )}
      {previewVideo && (
        <video
          class={`project-card__media-video ${hasHoverPreview ? "project-card__media-video--preview" : ""}`}
          src={previewVideo.src}
          poster={previewVideo.poster}
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={`${project.title} video preview`}
          autoplay={!hasHoverPreview}
        />
      )}
      {
        !hasMedia && (
          <div class="project-card__media-empty-shell">
            <span class="project-card__media-kicker text-mono">{project.category}</span>
            <div class="project-card__media-orbit" />
            <div class="project-card__media-tags">
              {project.tags.slice(0, 2).map((tag) => <span>{tag}</span>)}
            </div>
          </div>
        )
      }
    </div>

    <h3 class="project-card__title">{project.title}</h3>

    {
      project.roleTitle && (
        <p class="project-card__role text-mono text-muted">
          {project.roleTitle}
        </p>
      )
    }

    {
      projectDateRange && (
        <p class="project-card__timeframe text-mono text-muted">
          {projectDateRange}
        </p>
      )
    }

    <p class="project-card__summary">{summaryText}</p>

    {
      cardHighlights.length > 0 && (
        <ul
          class="project-card__highlights"
          aria-label={`${project.title} highlights`}
        >
          {cardHighlights.map((highlight) => (
            <li>{highlight}</li>
          ))}
        </ul>
      )
    }

    <div class="project-card__tags">
      {
        project.tags
          .slice(0, 4)
          .map((tag) => <span class="badge badge-purple">{tag}</span>)
      }
      {
        project.tags.length > 4 && (
          <span class="badge badge-gray">+{project.tags.length - 4}</span>
        )
      }
    </div>
  </a>

  <div class="project-card__actions">
    {
      actionLinks.length > 0 ? (
        actionLinks.map((link) => (
          <a
            href={link.url}
            class="btn btn-outline btn-sm"
            target="_blank"
            rel="noopener noreferrer"
          >
            {link.label} ↗
          </a>
        ))
      ) : (
        <a href={projectPath} class="btn btn-ghost btn-sm">
          View Details
        </a>
      )
    }
  </div>
</article>

<script>
  const supportsHoverPreview = window.matchMedia(
    "(hover: hover) and (pointer: fine)",
  ).matches;

  if (supportsHoverPreview) {
    const mediaCards = document.querySelectorAll(
      "[data-project-card-media='hover-preview']",
    );

    mediaCards.forEach((mediaCard) => {
      const container = mediaCard;
      const card = mediaCard.closest(".project-card");
      const video = mediaCard.querySelector("video");

      if (!card || !video) {
        return;
      }

      const playPreview = () => {
        container.classList.add("is-previewing");
        video.currentTime = 0;
        void video.play().catch(() => {
          container.classList.remove("is-previewing");
        });
      };

      const stopPreview = () => {
        container.classList.remove("is-previewing");
        video.pause();
        video.currentTime = 0;
      };

      card.addEventListener("mouseenter", playPreview);
      card.addEventListener("mouseleave", stopPreview);
      card.addEventListener("focusin", playPreview);
      card.addEventListener("focusout", (event) => {
        const focusEvent = event as FocusEvent;
        if (
          focusEvent.relatedTarget instanceof Node &&
          card.contains(focusEvent.relatedTarget)
        ) {
          return;
        }
        stopPreview();
      });
    });
  }
</script>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.01), transparent 28%),
      var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base),
      background var(--transition-base),
      transform var(--transition-base);
    position: relative;
    overflow: hidden;
    height: 100%;
  }

  .project-card__main-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    text-decoration: none;
    color: var(--color-text);
    flex: 1;
    position: relative;
    z-index: 1;
  }

  .project-card__arrow-link {
    text-decoration: none;
    position: relative;
    z-index: 1;
  }

  /* Corner accent */
  .project-card::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 88px;
    height: 88px;
    background: linear-gradient(
      135deg,
      rgba(201, 122, 43, 0.22),
      transparent 62%
    );
    clip-path: polygon(100% 0, 0 0, 100% 100%);
    transition:
      opacity var(--transition-base),
      transform var(--transition-base);
    opacity: 0.65;
  }

  .project-card:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-card-hover), var(--glow-accent);
    background: var(--color-bg-card-hover);
    transform: translateY(-2px);
  }

  .project-card:hover::before {
    opacity: 1;
    transform: scale(1.04);
  }

  .project-card--featured {
    border-color: rgba(124, 211, 137, 0.24);
  }

  .project-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    position: relative;
    z-index: 1;
  }

  .project-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .project-card__org {
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  a.project-card__org:hover,
  a.project-card__org:focus-visible {
    color: var(--color-accent);
  }

  .project-card__arrow {
    color: var(--color-accent);
    font-size: 1rem;
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity var(--transition-base),
      transform var(--transition-base);
    flex-shrink: 0;
  }

  .project-card:hover .project-card__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .project-card__title {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-text-heading);
    line-height: 1.3;
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .project-card__media {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg);
    aspect-ratio: 16 / 9;
    min-height: 0;
  }

  .project-card__media img,
  .project-card__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-card__media--empty {
    background:
      radial-gradient(circle at top right, var(--color-accent-glow), transparent 40%),
      linear-gradient(135deg, var(--color-accent-dim), transparent 58%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 55%),
      var(--color-bg);
  }

  .project-card__media-empty-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "kicker orbit"
      ". orbit"
      "tags orbit";
    align-items: stretch;
    height: 100%;
    padding: var(--space-md);
    gap: var(--space-md);
  }

  .project-card__media-kicker {
    grid-area: kicker;
    width: fit-content;
    max-width: 100%;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: rgba(4, 11, 25, 0.45);
  }

  .project-card__media-orbit {
    grid-area: orbit;
    align-self: center;
    justify-self: end;
    width: clamp(4.5rem, 20vw, 6.5rem);
    aspect-ratio: 1;
    border-radius: 999px;
    border: 1px solid var(--color-border-strong);
    box-shadow: inset 0 0 0 1px var(--color-border);
    opacity: 0.8;
    position: relative;
  }

  .project-card__media-orbit::before,
  .project-card__media-orbit::after {
    content: "";
    position: absolute;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    inset: 12%;
  }

  .project-card__media-orbit::after {
    inset: 28%;
    background: var(--color-accent-dim);
  }

  .project-card__media-tags {
    grid-area: tags;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    align-self: end;
    max-width: 100%;
  }

  .project-card__media-tags span {
    font-size: 0.72rem;
    line-height: 1;
    color: var(--color-text-muted);
    padding: 0.4rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: rgba(4, 11, 25, 0.35);
  }

  .project-card__media--hover-preview {
    isolation: isolate;
  }

  .project-card__media-image--cover,
  .project-card__media-video--preview {
    transition: opacity var(--transition-base);
  }

  .project-card__media-video--preview {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  .project-card__media.is-previewing .project-card__media-image--cover {
    opacity: 0;
  }

  .project-card__media.is-previewing .project-card__media-video--preview {
    opacity: 1;
  }

  @media (hover: none), (pointer: coarse) {
    .project-card__media-video--preview {
      display: none;
    }
  }

  .project-card__timeframe {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .project-card__role {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .project-card__summary {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
    position: relative;
    z-index: 1;
    /* Clamp to a single line for scan-first readability. */
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-card__highlights {
    margin: 0;
    padding-left: 1rem;
    display: grid;
    gap: 0.4rem;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    line-height: 1.5;
    min-height: 5.1rem;
  }

  .project-card__highlights li {
    margin: 0;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: auto;
    position: relative;
    z-index: 1;
  }

  .project-card__actions {
    display: flex;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: var(--space-sm);
    position: relative;
    z-index: 1;
  }

  .project-card__actions .btn {
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .project-card {
      padding: var(--space-lg);
      gap: var(--space-md);
    }

    .project-card__media-empty-shell {
      padding: var(--space-sm);
    }

    .project-card__media-orbit {
      width: clamp(4rem, 24vw, 5rem);
    }

    .project-card__media-tags {
      max-width: 100%;
    }

    .project-card__title {
      font-size: 1rem;
      line-height: 1.35;
    }

    .project-card__summary {
      font-size: 0.9rem;
      line-height: 1.55;
      -webkit-line-clamp: 2;
    }

    .project-card__highlights {
      font-size: 0.82rem;
      gap: 0.35rem;
      min-height: 0;
    }

    .project-card__actions {
      gap: var(--space-xs);
    }
  }
</style>
