---
// Nav.astro: Global navigation bar
import { isActivePath, stripBasePath, toBasePath } from "../utils/paths";
import { enabledNavItems, siteConfig } from "../data/siteConfig";

const currentPath = stripBasePath(Astro.url.pathname);
const navItems = enabledNavItems.map((link) => ({
  ...link,
  isActive: isActivePath(currentPath, link.href),
}));
---

<nav class="nav" aria-label="Main navigation" data-nav-root>
  <div class="nav__inner">
    <!-- Logo / Wordmark -->
    <a
      href={toBasePath("/")}
      class="nav__logo"
      aria-label={`${siteConfig.site.name} - Home`}
    >
      <span class="nav__logo-bracket">[</span>
      <span class="nav__logo-text">{siteConfig.site.logoText}</span>
      <span class="nav__logo-bracket">]</span>
    </a>

    <!-- Desktop Links -->
    <ul class="nav__links" role="list">
      {
        navItems.map((link) => {
          return (
            <li>
              <a
                href={toBasePath(link.href)}
                class={`nav__link ${link.isActive ? "nav__link--active" : ""}`}
                aria-current={link.isActive ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>

    <!-- Mobile menu toggle -->
    <button
      class="nav__toggle"
      data-nav-toggle
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="nav__toggle-bar"></span>
      <span class="nav__toggle-bar"></span>
      <span class="nav__toggle-bar"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="nav__mobile" id="mobile-menu" aria-hidden="true" data-nav-menu>
    <ul role="list">
      {
        navItems.map((link) => {
          return (
            <li>
              <a
                href={toBasePath(link.href)}
                class={`nav__mobile-link ${link.isActive ? "nav__mobile-link--active" : ""}`}
                aria-current={link.isActive ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: linear-gradient(
      180deg,
      var(--color-nav-bg-start),
      var(--color-nav-bg-end)
    );
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    height: var(--nav-height);
    box-shadow: var(--shadow-nav);
  }

  .nav__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-xl);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  /* Logo */
  .nav__logo {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-text-heading);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 1px;
    transition: color var(--transition-fast);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .nav__logo-bracket {
    color: var(--color-accent);
    font-size: 1.1em;
  }
  .nav__logo:hover {
    color: var(--color-accent);
  }

  .nav__logo-text {
    text-shadow: var(--shadow-glow-accent);
  }

  /* Desktop links */
  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    list-style: none;
  }

  .nav__link {
    font-family: var(--font-heading);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.4em 0.75em;
    border-radius: var(--radius-sm);
    transition:
      color var(--transition-fast),
      background var(--transition-fast);
    position: relative;
  }

  .nav__link:hover {
    color: var(--color-text);
    background: linear-gradient(
      90deg,
      var(--color-accent-glow-subtle),
      var(--color-accent2-glow-subtle)
    );
  }

  .nav__link:focus-visible {
    color: var(--color-text);
    background: linear-gradient(
      90deg,
      var(--color-accent-dim),
      var(--color-accent2-dim)
    );
  }

  .nav__link--active {
    color: var(--color-accent);
  }

  .nav__link--active::after {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%);
    width: 28px;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-accent),
      var(--color-accent2)
    );
  }

  /* Mobile toggle */
  .nav__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-sm);
    border-radius: var(--radius-sm);
  }

  .nav__toggle-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text-heading);
    border-radius: 1px;
    transition:
      transform var(--transition-base),
      opacity var(--transition-fast);
  }

  /* Mobile menu */
  .nav__mobile {
    display: none;
    background: linear-gradient(
      180deg,
      var(--color-nav-mobile-bg-start),
      var(--color-nav-mobile-bg-end)
    );
    border-top: 1px solid var(--color-border);
    padding: var(--space-md) var(--space-xl);
  }

  .nav__mobile ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .nav__mobile-link {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    transition:
      color var(--transition-fast),
      background var(--transition-fast);
    text-decoration: none;
  }

  .nav__mobile-link:hover,
  .nav__mobile-link--active {
    color: var(--color-accent);
    background: linear-gradient(
      90deg,
      var(--color-accent-glow-subtle-2),
      var(--color-accent2-glow-subtle-2)
    );
  }

  /* Responsive */
  @media (max-width: 768px) {
    .nav {
      height: auto;
      min-height: var(--nav-height);
    }

    .nav__inner {
      height: var(--nav-height);
      padding-inline: var(--space-md);
      gap: var(--space-md);
    }

    .nav__logo {
      font-size: 0.9rem;
      letter-spacing: 0.1em;
    }

    .nav__links {
      display: none;
    }

    .nav__toggle {
      display: flex;
    }

    .nav__mobile.is-open {
      display: block;
    }

    .nav__mobile {
      padding: var(--space-sm) var(--space-md) var(--space-md);
    }

    .nav__mobile-link {
      font-size: 0.8rem;
      padding: 0.7rem var(--space-md);
    }

    /* Toggle open state */
    .nav__toggle[aria-expanded="true"] .nav__toggle-bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav__toggle[aria-expanded="true"] .nav__toggle-bar:nth-child(2) {
      opacity: 0;
    }
    .nav__toggle[aria-expanded="true"] .nav__toggle-bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>

<script>
  const navRoots = Array.from(
    document.querySelectorAll<HTMLElement>("[data-nav-root]"),
  );

  navRoots.forEach((nav) => {
    if (nav.dataset.navInitialized === "true") {
      return;
    }

    nav.dataset.navInitialized = "true";

    const toggle = nav.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    const menu = nav.querySelector<HTMLElement>("[data-nav-menu]");
    const menuLinks = menu
      ? Array.from(
          menu.querySelectorAll<HTMLAnchorElement>(".nav__mobile-link"),
        )
      : [];

    const setMenuState = (isOpen: boolean) => {
      if (!toggle || !menu) {
        return;
      }

      toggle.setAttribute("aria-expanded", String(isOpen));
      menu.classList.toggle("is-open", isOpen);
      menu.setAttribute("aria-hidden", String(!isOpen));
    };

    const closeMenu = ({
      restoreFocus = true,
    }: { restoreFocus?: boolean } = {}) => {
      if (!toggle || !menu) {
        return;
      }

      setMenuState(false);

      if (restoreFocus) {
        toggle.focus();
      }
    };

    toggle?.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      setMenuState(!expanded);

      if (!expanded) {
        menuLinks[0]?.focus();
      }
    });

    menuLinks.forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu({ restoreFocus: false });
      });
    });

    nav.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") {
        return;
      }

      if (toggle?.getAttribute("aria-expanded") === "true") {
        closeMenu();
      }
    });
  });
</script>
