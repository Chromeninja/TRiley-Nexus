---
import CareerNarrativeHeader from "./CareerNarrativeHeader.astro";
import CareerNarrativeCompanyRow from "./CareerNarrativeCompanyRow.astro";
import { type CareerNarrativeData } from "../data/projects";

interface Props {
  data: CareerNarrativeData;
  label?: string;
  title?: string;
  subtitle?: string;
  initialOpenCompanyCount?: number;
  showControls?: boolean;
  compact?: boolean;
}

const {
  data,
  label = "// CAREER SYSTEM",
  title = "Explore the career timeline",
  subtitle = "Expand companies to inspect projects, operating context, and execution depth in-place.",
  initialOpenCompanyCount = 0,
  showControls = true,
  compact = false,
} = Astro.props;
---

<section
  class={`career-narrative panel ${compact ? "career-narrative--compact" : ""}`}
  data-career-narrative
  data-initial-open-count={String(initialOpenCompanyCount)}
>
  <CareerNarrativeHeader
    label={label}
    title={title}
    subtitle={subtitle}
    companyCount={data.companyCount}
    projectCount={data.projectCount}
    rangeLabel={data.rangeLabel}
    showControls={showControls}
  />

  <div class="career-narrative__companies">
    {
      data.companies.map((company, companyIndex) => (
        <CareerNarrativeCompanyRow
          company={company}
          companyIndex={companyIndex}
        />
      ))
    }
  </div>
</section>

<script>
  import { initCareerNarrativeInteractions } from "../utils/careerNarrativeInteractions";

  initCareerNarrativeInteractions();
</script>

<style>
  .career-narrative {
    position: relative;
    display: grid;
    gap: var(--space-lg);
    overflow: hidden;
  }

  .career-narrative__companies {
    display: grid;
    gap: var(--space-md);
  }

  /* :global() required: .career-narrative__summary is rendered by
     CareerNarrativeHeader.astro; the compact modifier lives on this section. */
  .career-narrative--compact :global(.career-narrative__summary) {
    width: auto;
  }

  @media (max-width: 540px) {
    .career-narrative {
      padding: var(--space-lg);
    }
  }
</style>
