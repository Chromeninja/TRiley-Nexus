---
interface Props {
  label: string;
  title: string;
  subtitle?: string;
  meta?: string;
}

const { label, title, subtitle, meta } = Astro.props;
const hasAside = Astro.slots.has("aside");
const hasMetaSlot = Astro.slots.has("meta");
const hasActions = Astro.slots.has("actions");
---

<section class="page-hero">
  <div class="container container--page">
    <div
      class:list={[
        "page-hero__layout",
        hasAside && "page-hero__layout--with-aside",
      ]}
    >
      <div class="page-hero__content">
        <p class="section-label">{label}</p>
        <span class="accent-line"></span>
        <h1>{title}</h1>
        {subtitle && <p class="page-hero__sub">{subtitle}</p>}
        {
          hasMetaSlot ? (
            <p class="page-hero__meta text-mono text-muted">
              <slot name="meta" />
            </p>
          ) : (
            meta && <p class="page-hero__meta text-mono text-muted">{meta}</p>
          )
        }
        {
          hasActions && (
            <div class="page-hero__actions">
              <slot name="actions" />
            </div>
          )
        }
      </div>

      {
        hasAside && (
          <div class="page-hero__aside">
            <slot name="aside" />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .page-hero {
    padding-block: var(--space-3xl);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
  }

  .page-hero__layout {
    display: block;
  }

  .page-hero__layout--with-aside {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
    gap: var(--space-2xl);
    align-items: center;
  }

  .page-hero__content {
    max-width: 60ch;
  }

  .page-hero__layout--with-aside .page-hero__content {
    max-width: 52ch;
  }

  .page-hero__sub {
    color: var(--color-text-muted);
    font-size: var(--font-size-lead);
    max-width: 55ch;
    margin-top: var(--space-md);
    margin-bottom: 0;
  }

  .page-hero__meta {
    font-size: var(--font-size-meta);
    margin-top: var(--space-md);
    margin-bottom: 0;
    letter-spacing: 0.04em;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  @media (max-width: 640px) {
    .page-hero {
      padding-block: var(--space-2xl);
    }

    .page-hero__layout--with-aside {
      grid-template-columns: 1fr;
    }

    .page-hero__content,
    .page-hero__layout--with-aside .page-hero__content {
      max-width: none;
    }
  }
</style>
