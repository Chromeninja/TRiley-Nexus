---
import type { TimelineMonthGroup } from "../data/careerTimeline";
import CareerScrollTimelineCard from "./CareerScrollTimelineCard.astro";

interface Props {
  monthGroup: TimelineMonthGroup;
}

const { monthGroup } = Astro.props;
---

<section id={monthGroup.key} class="career-scroll__month" data-observe-month>
  <header class="career-scroll__month-head">
    <h3>{monthGroup.monthLabel}</h3>
    <span class="text-mono">
      {monthGroup.projects.length} projects
    </span>
  </header>

  <ul class="career-scroll__cards" role="list">
    {
      monthGroup.projects.map((project) => (
        <CareerScrollTimelineCard project={project} isCurrent={false} />
      ))
    }
  </ul>
</section>

<style>
  .career-scroll__month {
    scroll-margin-top: calc(var(--nav-height) + var(--space-md));
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-md);
  }

  .career-scroll__month-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  .career-scroll__month-head h3 {
    margin: 0;
  }

  .career-scroll__month-head span {
    color: var(--color-text-dim);
    font-size: 0.78rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .career-scroll__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
  }

  @media (max-width: 640px) {
    .career-scroll__month-head {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-xs);
    }
  }
</style>
