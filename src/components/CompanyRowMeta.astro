---
import type { CareerAtlasCompanyNode } from "../data/projects";
import { toBasePath } from "../utils/paths";

interface Props {
  company: CareerAtlasCompanyNode;
}

const { company } = Astro.props;

function resolveLogoSrc(src: string): string {
  if (/^(https?:)?\/\//.test(src) || src.startsWith("data:")) {
    return src;
  }

  return toBasePath(src.startsWith("/") ? src : `/${src}`);
}
---

<div class="company-row__meta">
  <button
    type="button"
    class="company-row__toggle"
    data-company-toggle
    data-company-id={company.id}
    aria-controls={`${company.id}-panel`}
    aria-expanded="false"
  >
    <span class="company-row__name">{company.organization}</span>
    <span class="company-row__years text-mono">{company.rangeLabel}</span>
  </button>
  <p class="company-row__summary">{company.roleSummary}</p>
  {
    company.logo && (
      <div class="company-row__meta-logo-wrap">
        <img
          class="company-row__meta-logo"
          src={resolveLogoSrc(company.logo.src)}
          alt={company.logo.alt}
          loading="lazy"
        />
      </div>
    )
  }
</div>

<style>
  .company-row__meta {
    position: sticky;
    left: 0;
    z-index: 3;
    background: linear-gradient(
      90deg,
      rgba(12, 20, 17, 0.95),
      rgba(12, 20, 17, 0.7),
      transparent
    );
    padding-right: var(--space-sm);
  }

  .company-row__toggle {
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    text-align: left;
    width: 100%;
    display: grid;
    gap: 0.2rem;
    padding: 0;
  }

  .company-row__toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .company-row__name {
    font-family: var(--font-heading);
    font-size: 0.93rem;
    letter-spacing: 0.03em;
    color: color-mix(in srgb, var(--company-color), white 30%);
  }

  .company-row__years {
    font-size: 0.61rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .company-row__summary {
    margin: 0.45rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.79rem;
    line-height: 1.55;
  }

  .company-row__meta-logo-wrap {
    margin-top: var(--space-sm);
  }

  .company-row__meta-logo {
    display: block;
    width: auto;
    max-width: min(160px, 100%);
    max-height: 48px;
    object-fit: contain;
  }

  /* Ancestor state owned by CareerAtlas; the meta block itself is scoped here */
  :global(.career-atlas[data-view="overview"]) .company-row__meta {
    display: none;
  }

  @media (max-width: 640px) {
    .company-row__meta {
      position: static;
      background: none;
      padding-right: 0;
    }
  }
</style>
